---
/**
 * Öffentliches Steward-Register (Plan §4.6): alle veröffentlichten Entscheidungen, filterbar
 * nach Saison, Runde, Fahrer und Art; Button „Vorfall melden“, Link zum Strafenkatalog und
 * eine kurze Erklärung des Verfahrens.
 */
import BookOpen from '@lucide/astro/icons/book-open';
import Flag from '@lucide/astro/icons/flag';
import DecisionCard from '~/components/stewards/DecisionCard.astro';
import DecisionFilters from '~/components/stewards/DecisionFilters.astro';
import { decisionItems } from '~/components/stewards/model';
import Procedure from '~/components/stewards/Procedure.astro';
import { roundFilterValue } from '~/components/stewards/utils';
import EmptyState from '~/components/ui/EmptyState.astro';
import LocalTime from '~/components/ui/LocalTime.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import { alternates, url, useT, type Lang } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { VERDICTS } from '~/lib/db/types';
import { loadLeague } from '~/lib/server/league';
import { roundLabel } from '~/lib/view';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const league = await loadLeague();
const items = decisionItems(league, lang);
const season = league.currentSeason;
const multiSeason = new Set(items.map((i) => i.season.id)).size > 1;

// Runden mit laufender Protestfrist (zum Build-Zeitpunkt; das Skript blendet abgelaufene aus)
const openRounds = league.data.rounds
  .filter((r) => league.protestOpen(r))
  .sort((a, b) => (a.protest_deadline ?? '').localeCompare(b.protest_deadline ?? ''));

// Filter-Optionen aus den vorhandenen Entscheidungen
const seasonOptions = league.seasons
  .filter((s) => items.some((i) => i.season.id === s.id))
  .map((s) => ({ value: s.slug, label: t('common.seasonN', { n: s.number }) }));
const roundOptions = [...new Map(items.map((i) => [i.round.id, i])).values()]
  .sort((a, b) => b.season.number - a.season.number || a.round.number - b.round.number)
  .map((i) => ({
    value: roundFilterValue(i.season.slug, i.round.number),
    label: multiSeason ? `${roundLabel(i.round, i.track, lang)} (${t('common.seasonN', { n: i.season.number })})` : roundLabel(i.round, i.track, lang),
    season: i.season.slug,
  }));
const driverOptions = [...new Map(items.filter((i) => i.driver && !i.driver.anonymized).map((i) => [i.driver!.id, i.driver!])).values()]
  .sort((a, b) => a.gamertag.localeCompare(b.gamertag, lang, { sensitivity: 'base' }))
  .map((d) => ({ value: d.slug, label: d.gamertag }));
const verdictOptions = VERDICTS.filter((v) => items.some((i) => i.decision.verdict === v)).map((v) => ({
  value: v,
  label: t(`stewards.verdict.${v}`),
}));
---

<BaseLayout lang={lang} title={t('stewards.meta.title')} description={t('stewards.meta.description')} alternates={alternates('stewards')}>
  <PageHeader lang={lang} title={t('stewards.title')} eyebrow={t('stewards.eyebrow')} lead={t('stewards.lead')} updated={league.lastUpdated(league.decisions)}>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={url(lang, 'stewardsReport')} class="btn btn-primary">
        <Flag size={18} aria-hidden="true" />
        {t('stewards.reportCta')}
      </a>
      <a href={`${url(lang, 'rules')}#p8`} class="btn btn-secondary">
        <BookOpen size={18} aria-hidden="true" />
        {t('stewards.catalogueLink')}
      </a>
    </div>
  </PageHeader>

  <div class="container-page">
    {
      openRounds.length > 0 && (
        <aside class="alert alert-warning mt-8" aria-labelledby="open-deadline-title" data-open-deadlines>
          <h2 id="open-deadline-title" class="text-base font-semibold uppercase">
            {t('stewards.openDeadline.title')}
          </h2>
          <ul class="mt-2 grid gap-1 text-sm">
            {openRounds.map((r) => (
              <li data-deadline={r.protest_deadline}>
                <a href={url(lang, 'race', { season: league.season(r.season_id)!.slug, round: r.number })} class="font-semibold underline hover:text-teal">
                  {roundLabel(r, league.track(r.track_id), lang)}
                </a>
                {': '}
                {t('stewards.openDeadline.item')} <LocalTime instant={r.protest_deadline!} lang={lang} zone />
              </li>
            ))}
          </ul>
          <a href={url(lang, 'stewardsReport')} class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-green hover:text-teal">
            {t('stewards.reportCta')} →
          </a>
        </aside>
      )
    }

    <section class="section" aria-labelledby="register-title">
      <SectionTitle id="register-title" title={t('stewards.register.title')} />
      {
        items.length === 0 ? (
          <EmptyState title={t('stewards.register.empty')} text={t('stewards.register.emptyText')} />
        ) : (
          <>
            <DecisionFilters lang={lang} seasons={seasonOptions} rounds={roundOptions} drivers={driverOptions} verdicts={verdictOptions} total={items.length} />
            <ol class="mt-6 grid gap-4" aria-label={t('stewards.register.listLabel')}>
              {items.map((item) => (
                <li
                  data-decision-item
                  data-season={item.season.slug}
                  data-round={roundFilterValue(item.season.slug, item.round.number)}
                  data-driver={item.driver && !item.driver.anonymized ? item.driver.slug : ''}
                  data-verdict={item.decision.verdict}
                >
                  <DecisionCard lang={lang} item={item} showSeason={multiSeason} />
                </li>
              ))}
            </ol>
            <p class="card mt-4 p-5 text-muted" data-filter-empty hidden>
              {t('stewards.filter.none')}
            </p>
          </>
        )
      }
    </section>

    <div class="pb-16">
      <Procedure lang={lang} hours={season?.protest_window_hours ?? 48} />
    </div>
  </div>
</BaseLayout>

<script>
  // Abgelaufene Protestfristen ausblenden (die Seite ist statisch gebaut)
  const box = document.querySelector<HTMLElement>('[data-open-deadlines]');
  if (box) {
    const now = Date.now();
    let open = 0;
    box.querySelectorAll<HTMLElement>('[data-deadline]').forEach((li) => {
      const end = new Date(li.dataset.deadline ?? '').getTime();
      if (Number.isFinite(end) && end <= now) li.hidden = true;
      else open++;
    });
    if (open === 0) box.hidden = true;
  }
</script>
