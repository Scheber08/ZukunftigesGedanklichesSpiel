---
/**
 * Vorfall melden (Plan §4.6): nur Runden mit offener Protestfrist; Runde/Session, eigener
 * Gamertag und Beteiligte aus dem Grid der Runde, Rennrunde und Kurve, Beschreibung,
 * Clip-Link (Pflicht) mit Zeitstempel und Discord-Name für Rückfragen.
 * Gibt es mehrere offene Runden, wird die Runde zuerst gewählt (GET, klappt ohne JavaScript).
 */
import { actions, isInputError } from 'astro:actions';
import Clock from '@lucide/astro/icons/clock';
import TriangleAlert from '@lucide/astro/icons/triangle-alert';
import ChoiceGroup from '~/components/forms/ChoiceGroup.astro';
import ErrorSummary from '~/components/forms/ErrorSummary.astro';
import Field from '~/components/forms/Field.astro';
import Honeypot from '~/components/forms/Honeypot.astro';
import SelectField from '~/components/forms/SelectField.astro';
import SubmitButton from '~/components/forms/SubmitButton.astro';
import TrackEvent from '~/components/forms/TrackEvent.astro';
import Turnstile from '~/components/forms/Turnstile.astro';
import LocalTime from '~/components/ui/LocalTime.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import { alternates, url, useT, type Lang } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { collectErrors } from '~/lib/forms/errors';
import { LIMITS } from '~/lib/forms/schemas';
import { loadOpenRounds, loadRoundGrid, loadRoundSessions, type GridDriver } from '~/lib/forms/server';
import { positiveInt, posted, postedAll, postedForm } from '~/lib/forms/values';
import { getPublicStore } from '~/lib/server/db';
import { breadcrumbJsonLd, roundLabel } from '~/lib/view';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
Astro.response.headers.set('Cache-Control', 'private, no-store');

const store = getPublicStore();
const openRounds = await loadOpenRounds(store);
const reportUrl = url(lang, 'stewardsReport');

const result = Astro.getActionResult(actions.reportIncident);
const success = result && !result.error ? result.data : null;
const form = result?.error ? await postedForm(Astro.request) : null;
const { fields: errors, form: formError } = collectErrors(lang, result?.error, isInputError(result?.error));

// Gewählte Runde: aus dem abgeschickten Formular, aus ?round= oder die einzige offene.
// Ist die abgeschickte Runde inzwischen zu, wird nicht stillschweigend eine andere gewählt.
const postedRound = positiveInt(posted(form, 'round_id'));
const requested = postedRound ?? positiveInt(Astro.url.searchParams.get('round'));
const selected =
  openRounds.find((o) => o.round.id === requested) ?? (postedRound == null && openRounds.length === 1 ? openRounds[0] : undefined);
const postedDescription = selected ? null : posted(form, 'description');
const [sessions, grid] = selected
  ? await Promise.all([loadRoundSessions(store, selected.round.id), loadRoundGrid(store, selected.round.id)])
  : [[], [] as GridDriver[]];

// Erfolgsseite: Rundenbezeichnung
let successLabel = '';
if (success) {
  const [track] = await store.select('tracks', { eq: { id: success.trackId }, limit: 1 });
  successLabel = roundLabel({ number: success.roundNumber }, track, lang);
}

const driverName = (g: GridDriver) => (g.anonymized ? `${t('common.formerDriver')} #${g.driverId}` : g.gamertag);
const defaultSession = sessions.find((s) => s.type === 'race')?.id ?? sessions[0]?.id;

const crumbs = [
  { label: t('nav.home'), href: url(lang, 'home') },
  { label: t('nav.stewards'), href: url(lang, 'stewards') },
  { label: t('stewards.report.title'), href: reportUrl },
];
const jsonLd = breadcrumbJsonLd(
  Astro.site ?? new URL(Astro.url.origin),
  crumbs.map((c) => ({ name: c.label, href: c.href })),
);

const labels = {
  round_id: t('stewards.report.round'),
  session_id: t('stewards.report.session'),
  reporter_driver_id: t('stewards.report.reporter'),
  involved_driver_ids: t('stewards.report.involved'),
  lap: t('stewards.report.lap'),
  corner: t('stewards.report.corner'),
  description: t('stewards.report.description'),
  clip_url: t('stewards.report.clip'),
  clip_timestamp: t('stewards.report.clipTimestamp'),
  reporter_contact: t('stewards.report.contact'),
};
---

<BaseLayout lang={lang} title={t('stewards.report.metaTitle')} description={t('stewards.report.metaDescription')} alternates={alternates('stewardsReport')} jsonLd={jsonLd}>
  <PageHeader
    lang={lang}
    title={t('stewards.report.title')}
    eyebrow={t('stewards.report.eyebrow')}
    lead={t('stewards.report.lead')}
    breadcrumbs={crumbs}
  />

  <div class="container-page section grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
    <section class="min-w-0" aria-labelledby="report-title">
      {
        success ? (
          <div class="grid gap-6">
            <div class="alert alert-success" role="status">
              <h2 id="report-title" class="text-2xl uppercase">
                {t('stewards.report.success.title')}
              </h2>
              <p class="mt-2 font-semibold">{t('stewards.report.success.ref', { id: success.id, round: successLabel })}</p>
            </div>
            <TrackEvent name="incident_reported" />
            <div class="card p-5 md:p-6">
              <h3 class="text-xl uppercase">{t('stewards.report.success.next')}</h3>
              <ol class="mt-4 grid gap-4">
                {([1, 2, 3, 4] as const).map((n) => (
                  <li class="flex gap-4">
                    <span class="step-no shrink-0" aria-hidden="true">
                      {n}
                    </span>
                    <p class="pt-1.5">{t(`stewards.report.success.step${n}`)}</p>
                  </li>
                ))}
              </ol>
              <div class="mt-6 flex flex-wrap gap-3">
                <a href={url(lang, 'stewards')} class="btn btn-primary">
                  {t('stewards.report.success.register')}
                </a>
                <a href={reportUrl} class="btn btn-secondary">
                  {t('stewards.report.success.another')}
                </a>
              </div>
            </div>
          </div>
        ) : openRounds.length === 0 ? (
          <div class="alert alert-warning">
            <h2 id="report-title" class="text-xl uppercase">
              {t('stewards.report.closed.title')}
            </h2>
            {formError && (
              <p class="mt-2 font-semibold" role="alert">
                {formError}
              </p>
            )}
            <p class="mt-2">{t('stewards.report.closed.text')}</p>
            {postedDescription && (
              <details class="accordion mt-4">
                <summary>{t('stewards.report.closed.yourText')}</summary>
                <p class="whitespace-pre-line break-words pb-4 text-sm">{postedDescription}</p>
              </details>
            )}
            <div class="mt-4 flex flex-wrap gap-3">
              <a href={url(lang, 'contact')} class="btn btn-secondary btn-sm">
                {t('stewards.report.closed.contact')}
              </a>
              <a href={url(lang, 'stewards')} class="btn btn-ghost btn-sm border border-border">
                {t('stewards.report.closed.register')}
              </a>
            </div>
          </div>
        ) : !selected ? (
          <form method="get" action={reportUrl} class="card grid gap-5 p-5 md:p-6">
            <h2 id="report-title" class="sr-only">
              {t('stewards.report.formTitle')}
            </h2>
            <ErrorSummary lang={lang} errors={{}} labels={labels} formError={formError ?? (errors.round_id ? errors.round_id : null)} />
            {postedDescription && (
              <details class="accordion">
                <summary>{t('stewards.report.closed.yourText')}</summary>
                <p class="whitespace-pre-line break-words pb-4 text-sm">{postedDescription}</p>
              </details>
            )}
            <ChoiceGroup
              lang={lang}
              name="round"
              id="f-round"
              legend={t('stewards.report.chooseRound.legend')}
              required
              options={openRounds.map((o) => ({ value: o.round.id, label: roundLabel(o.round, o.track, lang) }))}
            />
            <div>
              <button type="submit" class="btn btn-primary">
                {t('stewards.report.chooseRound.submit')}
              </button>
            </div>
          </form>
        ) : (
          <>
            <SectionTitle id="report-title" title={t('stewards.report.formTitle')} />
            <p class="mb-4 text-sm text-muted">{t('forms.requiredLegend')}</p>
            <ErrorSummary lang={lang} errors={errors} labels={labels} formError={formError} />
            <form method="POST" action={actions.reportIncident} class="card mt-6 grid gap-6 p-5 md:p-6">
              <Honeypot lang={lang} />
              <input type="hidden" name="round_id" value={selected.round.id} />

              <div class="round-box" id="f-round_id">
                <p class="micro">{t('stewards.report.round')}</p>
                <p class="mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <strong class="text-lg">{roundLabel(selected.round, selected.track, lang)}</strong>
                  <span class="text-sm text-muted">
                    {t('stewards.report.deadlines.item')}{' '}
                    <LocalTime instant={selected.round.protest_deadline!} lang={lang} zone />
                  </span>
                </p>
                {openRounds.length > 1 && (
                  <a href={reportUrl} class="mt-1 inline-flex min-h-11 items-center text-sm font-semibold text-green hover:text-teal">
                    {t('stewards.report.chooseRound.change')}
                  </a>
                )}
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <SelectField
                  lang={lang}
                  name="session_id"
                  label={labels.session_id}
                  required
                  placeholder={null}
                  error={errors.session_id}
                  value={posted(form, 'session_id') ?? defaultSession}
                  options={sessions.map((s) => ({ value: s.id, label: t(`session.${s.type}`) }))}
                />
                <SelectField
                  lang={lang}
                  name="reporter_driver_id"
                  label={labels.reporter_driver_id}
                  required
                  hint={t('stewards.report.reporterHint')}
                  error={errors.reporter_driver_id}
                  value={posted(form, 'reporter_driver_id')}
                  placeholder={t('stewards.report.choose')}
                  options={grid.map((g) => ({ value: g.driverId, label: g.number != null ? `#${g.number} ${driverName(g)}` : driverName(g) }))}
                />
              </div>

              <ChoiceGroup
                lang={lang}
                type="checkbox"
                name="involved_driver_ids"
                legend={labels.involved_driver_ids}
                required
                columns={3}
                hint={t('stewards.report.involvedHint')}
                error={errors.involved_driver_ids}
                value={postedAll(form, 'involved_driver_ids')}
                options={grid.map((g) => ({ value: g.driverId, label: driverName(g), meta: g.number != null ? `#${g.number}` : undefined }))}
              />

              <div class="grid gap-5 sm:grid-cols-[10rem_minmax(0,1fr)]">
                <Field
                  lang={lang}
                  name="lap"
                  type="number"
                  label={labels.lap}
                  hint={t('stewards.report.lapHint')}
                  error={errors.lap}
                  value={posted(form, 'lap')}
                  min={LIMITS.lap.min}
                  max={LIMITS.lap.max}
                  step={1}
                  inputmode="numeric"
                  autocomplete="off"
                />
                <Field
                  lang={lang}
                  name="corner"
                  label={labels.corner}
                  required
                  hint={t('stewards.report.cornerHint')}
                  error={errors.corner}
                  value={posted(form, 'corner')}
                  maxlength={LIMITS.corner.max}
                  autocomplete="off"
                />
              </div>

              <Field
                lang={lang}
                name="description"
                type="textarea"
                label={labels.description}
                required
                hint={t('stewards.report.descriptionHint')}
                error={errors.description}
                value={posted(form, 'description')}
                rows={6}
                minlength={LIMITS.description.min}
                maxlength={LIMITS.description.max}
              />

              <div class="grid gap-5 sm:grid-cols-[minmax(0,1fr)_10rem]">
                <Field
                  lang={lang}
                  name="clip_url"
                  type="url"
                  label={labels.clip_url}
                  required
                  hint={t('stewards.report.clipHint')}
                  error={errors.clip_url}
                  value={posted(form, 'clip_url')}
                  maxlength={LIMITS.clipUrl.max}
                  inputmode="url"
                  autocomplete="off"
                  placeholder="https://"
                  spellcheck={false}
                />
                <Field
                  lang={lang}
                  name="clip_timestamp"
                  label={labels.clip_timestamp}
                  required
                  hint={t('stewards.report.clipTimestampHint')}
                  error={errors.clip_timestamp}
                  value={posted(form, 'clip_timestamp')}
                  maxlength={LIMITS.clipTimestamp.max}
                  autocomplete="off"
                  placeholder="01:23"
                  inputmode="numeric"
                />
              </div>

              <Field
                lang={lang}
                name="reporter_contact"
                label={labels.reporter_contact}
                required
                hint={t('stewards.report.contactHint')}
                error={errors.reporter_contact}
                value={posted(form, 'reporter_contact')}
                maxlength={LIMITS.discord.max}
                autocomplete="off"
                spellcheck={false}
                attrs={{ autocapitalize: 'none' }}
                class="sm:max-w-md"
              />

              <div class="alert alert-warning flex gap-3" role="note">
                <TriangleAlert size={20} class="mt-0.5 shrink-0 text-warning" aria-hidden="true" />
                <div>
                  <p class="font-semibold">{t('stewards.report.abuse.title')}</p>
                  <p class="mt-1 text-sm text-muted">{t('stewards.report.abuse.text')}</p>
                </div>
              </div>

              <p class="text-sm text-muted">
                {t('stewards.report.privacy.before')}
                <a href={url(lang, 'privacy')} class="text-green underline hover:text-teal">
                  {t('stewards.report.privacy.link')}
                </a>
                {t('stewards.report.privacy.after')}
              </p>

              <Turnstile lang={lang} />
              <div>
                <SubmitButton lang={lang} label={t('stewards.report.submit')} />
              </div>
            </form>
          </>
        )
      }
    </section>

    <aside class="grid gap-4" aria-labelledby="deadlines-title">
      <div class="card p-5">
        <h2 id="deadlines-title" class="flex items-center gap-2 text-lg uppercase">
          <Clock size={20} class="text-teal" aria-hidden="true" />
          {t('stewards.report.deadlines.title')}
        </h2>
        {
          openRounds.length > 0 ? (
            <ul class="mt-3 grid gap-3 text-sm">
              {openRounds.map((o) => (
                <li>
                  <p class="font-semibold">{roundLabel(o.round, o.track, lang)}</p>
                  <p class="text-muted">
                    {t('stewards.report.deadlines.item')} <LocalTime instant={o.round.protest_deadline!} lang={lang} zone />
                  </p>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-sm text-muted">{t('stewards.report.closed.title')}</p>
          )
        }
      </div>
      <div class="card p-5 text-sm">
        <p class="text-muted">{t('stewards.procedure.evidence.text')}</p>
        <a href={`${url(lang, 'rules')}#p7`} class="mt-2 inline-flex min-h-11 items-center font-semibold text-green hover:text-teal">
          {t('stewards.procedure.rulesLink')} →
        </a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .round-box {
    padding: 0.875rem 1rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }
  .step-no {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--g-accent);
    color: #000;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.125rem;
    line-height: 1;
  }
</style>
