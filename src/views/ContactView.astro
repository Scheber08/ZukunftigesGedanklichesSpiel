---
/**
 * Kontaktformular (Plan §4.10, §9.2): zweiter schneller Kontaktweg neben der E-Mail-Adresse
 * fürs Impressum. Speichert in contact_messages, Discord-Hinweis nur mit Betreff.
 */
import { actions, isInputError } from 'astro:actions';
import Mail from '@lucide/astro/icons/mail';
import BrandIcon from '~/components/ui/BrandIcon.astro';
import ErrorSummary from '~/components/forms/ErrorSummary.astro';
import Field from '~/components/forms/Field.astro';
import Honeypot from '~/components/forms/Honeypot.astro';
import SubmitButton from '~/components/forms/SubmitButton.astro';
import Turnstile from '~/components/forms/Turnstile.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import { SITE } from '~/config/site';
import { alternates, url, useT, type Lang } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { collectErrors } from '~/lib/forms/errors';
import { LIMITS } from '~/lib/forms/schemas';
import { posted, postedForm } from '~/lib/forms/values';
import { loadPublicSettings } from '~/lib/server/league';
import { breadcrumbJsonLd } from '~/lib/view';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
Astro.response.headers.set('Cache-Control', 'private, no-store');

const settings = await loadPublicSettings();
const result = Astro.getActionResult(actions.sendContact);
const success = result && !result.error ? result.data : null;
const form = result?.error ? await postedForm(Astro.request) : null;
const { fields: errors, form: formError } = collectErrors(lang, result?.error, isInputError(result?.error));

const crumbs = [
  { label: t('nav.home'), href: url(lang, 'home') },
  { label: t('forms.contact.title'), href: url(lang, 'contact') },
];
const jsonLd = breadcrumbJsonLd(
  Astro.site ?? new URL(Astro.url.origin),
  crumbs.map((c) => ({ name: c.label, href: c.href })),
);

const labels = {
  name: t('forms.contact.name'),
  email: t('forms.contact.email'),
  subject: t('forms.contact.subject'),
  message: t('forms.contact.message'),
};
---

<BaseLayout lang={lang} title={t('forms.contact.metaTitle')} description={t('forms.contact.metaDescription')} alternates={alternates('contact')} jsonLd={jsonLd}>
  <PageHeader lang={lang} title={t('forms.contact.title')} eyebrow={t('forms.contact.eyebrow')} lead={t('forms.contact.lead')} breadcrumbs={crumbs} />

  <div class="container-page section grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
    <section aria-labelledby="contact-form-title" class="min-w-0">
      {
        success ? (
          <div class="alert alert-success" role="status">
            <h2 id="contact-form-title" class="text-xl uppercase">
              {t('forms.contact.success.title')}
            </h2>
            <p class="mt-2">{t('forms.contact.success.text')}</p>
            <a href={url(lang, 'contact')} class="btn btn-secondary btn-sm mt-4">
              {t('forms.contact.success.another')}
            </a>
          </div>
        ) : (
          <>
            <h2 id="contact-form-title" class="section-title mb-2 uppercase">
              {t('forms.contact.formTitle')}
            </h2>
            <p class="mb-6 text-sm text-muted">{t('forms.requiredLegend')}</p>
            <ErrorSummary lang={lang} errors={errors} labels={labels} formError={formError} />
            <form method="POST" action={actions.sendContact} class="card mt-6 grid gap-5 p-5 md:p-6" novalidate={false}>
              <Honeypot lang={lang} />
              <div class="grid gap-5 sm:grid-cols-2">
                <Field
                  lang={lang}
                  name="name"
                  label={labels.name}
                  required
                  hint={t('forms.contact.nameHint')}
                  error={errors.name}
                  value={posted(form, 'name')}
                  autocomplete="nickname"
                  maxlength={LIMITS.name.max}
                />
                <Field
                  lang={lang}
                  name="email"
                  type="email"
                  label={labels.email}
                  required
                  hint={t('forms.contact.emailHint')}
                  error={errors.email}
                  value={posted(form, 'email')}
                  autocomplete="email"
                  maxlength={LIMITS.email.max}
                  spellcheck={false}
                />
              </div>
              <Field
                lang={lang}
                name="subject"
                label={labels.subject}
                required
                error={errors.subject}
                value={posted(form, 'subject')}
                minlength={LIMITS.subject.min}
                maxlength={LIMITS.subject.max}
              />
              <Field
                lang={lang}
                name="message"
                type="textarea"
                label={labels.message}
                required
                hint={t('forms.contact.messageHint')}
                error={errors.message}
                value={posted(form, 'message')}
                rows={8}
                minlength={LIMITS.message.min}
                maxlength={LIMITS.message.max}
              />
              <Turnstile lang={lang} />
              <p class="text-sm text-muted">
                {t('forms.contact.privacy.before')}
                <a href={url(lang, 'privacy')} class="text-green underline hover:text-teal">
                  {t('forms.contact.privacy.link')}
                </a>
                {t('forms.contact.privacy.after')}
              </p>
              <div>
                <SubmitButton lang={lang} label={t('forms.contact.submit')} />
              </div>
            </form>
          </>
        )
      }
    </section>

    <aside class="grid gap-4" aria-label={t('forms.contact.emailTitle')}>
      <div class="card p-5">
        <h2 class="flex items-center gap-2 text-lg uppercase">
          <Mail size={20} class="text-teal" aria-hidden="true" />
          {t('forms.contact.emailTitle')}
        </h2>
        <p class="mt-2 text-sm text-muted">{t('forms.contact.emailText')}</p>
        <p class="mt-1">
          <a href={`mailto:${SITE.contactEmail}`} class="inline-flex min-h-11 items-center break-all font-semibold text-green underline hover:text-teal">
            {SITE.contactEmail}
          </a>
        </p>
        <p class="mt-3 text-sm text-muted">{t('forms.contact.imprintNote')}</p>
        <a href={url(lang, 'imprint')} class="mt-1 inline-flex min-h-11 items-center text-sm font-semibold text-green hover:text-teal">
          {t('forms.contact.imprintLink')} →
        </a>
      </div>
      {
        settings.discord_invite.url && (
          <div class="card p-5">
            <p class="text-sm text-muted">{t('forms.contact.discordHint')}</p>
            <a href={settings.discord_invite.url} class="btn btn-secondary btn-sm mt-3" target="_blank" rel="noopener" data-track="discord_click">
              <BrandIcon name="discord" size={18} />
              {t('common.joinDiscord')}
            </a>
          </div>
        )
      }
    </aside>
  </div>
</BaseLayout>
