---
/**
 * Partner (Plan §4.8, §9.3): Partnerkarten mit Logo, Text, Link (rel="sponsored") und
 * dem Label „Anzeige“, dazu „Partner werden“ und die Ausschlusskriterien.
 */
import Ban from '@lucide/astro/icons/ban';
import ExternalLink from '@lucide/astro/icons/external-link';
import Handshake from '@lucide/astro/icons/handshake';
import Badge from '~/components/ui/Badge.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import TranslationNotice from '~/components/ui/TranslationNotice.astro';
import { alternates, url, useT, type Lang } from '~/i18n';
import MobileWrap from '~/components/content/MobileWrap.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { localized } from '~/lib/league/league';
import { loadLeague } from '~/lib/server/league';
import { breadcrumbJsonLd } from '~/lib/view';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const league = await loadLeague();
const partners = league.partners;
const hasFallback = partners.some((p) => localized(p, 'text', lang).fallback);

const exclusions = ['gambling', 'betting', 'skins', 'alcohol', 'crypto'] as const;

/** Nur http(s)-Links aus der DB verlinken. */
const safeUrl = (value: string) => (/^https?:\/\//i.test(value.trim()) ? value.trim() : null);
const host = (value: string) => {
  try {
    return new URL(value).hostname.replace(/^www\./, '');
  } catch {
    return value;
  }
};

const site = Astro.site ?? new URL(Astro.url.origin);
const crumbs = [
  { label: t('nav.home'), href: url(lang, 'home') },
  { label: t('content.partners.title'), href: url(lang, 'partners') },
];
const jsonLd = breadcrumbJsonLd(
  site,
  crumbs.map((c) => ({ name: c.label, href: c.href })),
);
---

<BaseLayout lang={lang} title={t('content.partners.title')} description={t('content.partners.description')} alternates={alternates('partners')} jsonLd={jsonLd}>
  <PageHeader lang={lang} title={t('content.partners.title')} lead={t('content.partners.lead')} breadcrumbs={crumbs} updated={league.lastUpdated(partners)} />

  <div class="container-page">
    <section class="section" aria-labelledby="partners-list">
      <h2 id="partners-list" class="sr-only">{t('content.partners.title')}</h2>
      <TranslationNotice lang={lang} show={hasFallback} />
      {
        partners.length === 0 ? (
          <EmptyState title={t('content.partners.empty.title')} text={t('content.partners.empty.text')} />
        ) : (
          <ul class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
            {partners.map((p) => {
              const text = localized(p, 'text', lang);
              const href = safeUrl(p.url);
              return (
                <li class="card card-hover partner-card">
                  <div class="flex items-start justify-between gap-3">
                    <div class="logo-box">
                      {p.logo ? (
                        <img src={p.logo} alt={t('content.partners.logoAlt', { name: p.name })} width="240" height="80" loading="lazy" decoding="async" class="logo" />
                      ) : (
                        <span class="logo-fallback" aria-hidden="true">
                          {p.name}
                        </span>
                      )}
                    </div>
                    {p.label_ad && <Badge variant="muted">{t('common.ad')}</Badge>}
                  </div>
                  <h3 class="mt-4 text-xl uppercase">{p.name}</h3>
                  <p class="mt-2 flex-1 text-sm text-muted" lang={text.fallback ? 'de' : undefined}>
                    {text.text}
                  </p>
                  {href && (
                    <a href={href} rel="sponsored noopener" target="_blank" class="btn btn-secondary btn-sm mt-5 self-start">
                      {t('content.partners.visit')}
                      <span class="sr-only">
                        : {host(href)} {t('a11y.externalLink')}
                      </span>
                      <ExternalLink size={14} aria-hidden="true" />
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
      <p class="mt-6 max-w-3xl text-sm text-muted">{t('content.partners.independence')}</p>
    </section>

    <section class="section border-t border-border" aria-labelledby="partners-become">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:items-start">
        <div class="card become-card p-6 md:p-8">
          <span class="icon-bubble" aria-hidden="true"><Handshake size={22} /></span>
          <h2 id="partners-become" class="mt-4 text-2xl uppercase">{t('content.partners.become.title')}</h2>
          <p class="mt-3 text-muted">{t('content.partners.become.text')}</p>
          <a href={url(lang, 'contact')} class="btn btn-primary mt-6">{t('content.partners.become.cta')}</a>
        </div>
        <div class="p-1 md:p-2">
          <SectionTitle id="partners-exclusions" title={t('content.partners.exclusions.title')} as="h2" />
          <p class="-mt-3 text-sm text-muted">{t('content.partners.exclusions.lead')}</p>
          <ul class="mt-5 grid gap-2">
            {
              exclusions.map((key) => (
                <li class="flex items-center gap-3 text-sm">
                  <Ban size={18} aria-hidden="true" class="shrink-0 text-danger" />
                  <span>{t(`content.partners.exclusions.${key}`)}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </div>
  <MobileWrap />
</BaseLayout>

<style>
  .partner-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }
  .logo-box {
    display: grid;
    place-items: center start;
    min-height: 4rem;
  }
  .logo {
    width: auto;
    max-width: 12rem;
    height: 3.5rem;
    object-fit: contain;
  }
  .logo-fallback {
    display: inline-grid;
    place-items: center;
    min-width: 4rem;
    height: 3.5rem;
    padding: 0 1rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-control);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .icon-bubble {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    background: var(--color-surface-2);
    color: var(--color-teal);
  }
  .become-card {
    background:
      radial-gradient(70% 90% at 100% 0%, rgb(14 90 97 / 0.35), transparent 70%),
      var(--color-surface-1);
  }
</style>
