---
/**
 * Entscheidungsformular (Plan §5.3): Fahrer, Session, Art, Zeit/Plätze, Strafpunkte (nur wenn in
 * der Saison aktiv), Begründung DE (Pflicht, Markdown) + EN, Regel-Referenz, Clip, Textbausteine
 * aus dem Strafenkatalog. Funktioniert ohne JavaScript; mit JS fügt „Baustein einfügen“ Text ein
 * und blendet unpassende Felder aus.
 *
 * Strafpunkte (Plan Phase 2): Mit `penalty` zeigt das Formular die Konten der Beteiligten und warnt
 * deutlich, wenn die neue Entscheidung eine Schwelle erreicht (mit JS live beim Tippen, ohne JS nach
 * dem Speichern auf der Entscheidungskarte).
 */
import type { CatalogEntry } from '~/lib/admin/raceday/catalog';
import { catalogSnippet, CATALOG_NUMBER, suggestVerdict } from '~/lib/admin/raceday/catalog';
import { penaltyPointsNote, type DecisionFormPenalty } from '~/lib/admin/raceday/decision-input';
import { SESSION_LABEL, VERDICT_LABEL } from '~/lib/admin/raceday/labels';
import type { Id, SessionRow, Verdict } from '~/lib/db/types';
import { VERDICTS } from '~/lib/db/types';

export interface DecisionFormValues {
  decisionId?: Id | null;
  incidentId?: Id | null;
  driverId?: Id | null;
  sessionId?: Id | null;
  verdict?: Verdict;
  timeSeconds?: number | null;
  positions?: number | null;
  penaltyPoints?: number | null;
  reasoningDe?: string;
  reasoningEn?: string | null;
  ruleRef?: string | null;
  clipUrl?: string | null;
}

interface Props {
  action: string;
  idPrefix: string;
  roundId: Id;
  values: DecisionFormValues;
  sessions: SessionRow[];
  driverOptions: Array<{ id: Id; label: string }>;
  catalog: CatalogEntry[];
  penaltyPointsEnabled: boolean;
  /** Konten und Schwellen (nur bei aktivem Strafpunkte-System) */
  penalty?: DecisionFormPenalty | null;
  submitLabel: string;
  disabled?: boolean;
  disabledReason?: string | null;
}
const {
  action,
  idPrefix: p,
  roundId,
  values: v,
  sessions,
  driverOptions,
  catalog,
  penaltyPointsEnabled,
  penalty = null,
  submitLabel,
  disabled = false,
  disabledReason,
} = Astro.props;
const verdict = v.verdict ?? 'no_action';
const race = sessions.find((s) => s.type === 'race');
const sessionId = v.sessionId ?? race?.id ?? null;

// Strafpunkte: Hinweis für die Werte im Formular (nach einem Fehler oder beim Bearbeiten eines Entwurfs)
const ppNote =
  penalty && v.driverId != null && verdict !== 'no_action'
    ? penaltyPointsNote(penalty.active[String(v.driverId)] ?? 0, v.penaltyPoints, penalty.config, penalty.roundExpired)
    : null;
const ppData = penalty ? JSON.stringify({ config: penalty.config, active: penalty.active, roundExpired: penalty.roundExpired }) : undefined;
const ppStatus = { ok: 'unauffällig', warning: 'Verwarnschwelle erreicht', ban: 'Sperrschwelle erreicht' } as const;
const ppAlert = { info: 'alert pp-info', warning: 'alert alert-warning pp-strong', ban: 'alert alert-danger pp-strong' } as const;
---

<form method="POST" action={action} class="decision-form" data-decision-form>
  <input type="hidden" name="roundId" value={roundId} />
  {v.decisionId != null && <input type="hidden" name="decisionId" value={v.decisionId} />}
  {v.incidentId != null && <input type="hidden" name="incidentId" value={v.incidentId} />}

  {disabled && disabledReason && <p class="alert alert-warning">{disabledReason}</p>}

  <fieldset disabled={disabled} class="grid gap-4">
    <legend class="sr-only">Entscheidung</legend>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="field">
        <label for={`${p}-driver`} class="label">Fahrer <span class="req" aria-hidden="true">*</span></label>
        <select id={`${p}-driver`} name="driverId" class="select" required>
          <option value="" disabled selected={v.driverId == null}>Bitte wählen</option>
          {
            driverOptions.map((d) => (
              <option value={d.id} selected={d.id === v.driverId}>
                {d.label}
              </option>
            ))
          }
        </select>
      </div>
      <div class="field">
        <label for={`${p}-session`} class="label">Session</label>
        <select id={`${p}-session`} name="sessionId" class="select">
          {
            sessions.map((s) => (
              <option value={s.id} selected={s.id === sessionId}>
                {SESSION_LABEL[s.type]}
              </option>
            ))
          }
        </select>
        <p class="field-hint">Zeit-, Positions- und DSQ-Strafen wirken auf diese Session.</p>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <div class="field">
        <label for={`${p}-verdict`} class="label">Art der Entscheidung <span class="req" aria-hidden="true">*</span></label>
        <select id={`${p}-verdict`} name="verdict" class="select" required data-verdict>
          {
            VERDICTS.map((x) => (
              <option value={x} selected={x === verdict}>
                {VERDICT_LABEL[x]}
              </option>
            ))
          }
        </select>
      </div>
      <div class="field" data-for="time_penalty">
        <label for={`${p}-time`} class="label">Zeitstrafe (Sekunden)</label>
        <input id={`${p}-time`} name="timeSeconds" type="number" min="1" max="120" inputmode="numeric" class="input" value={v.timeSeconds ?? ''} />
        <p class="field-hint">Nur bei Zeitstrafe.</p>
      </div>
      <div class="field" data-for="position_penalty grid_penalty_next">
        <label for={`${p}-positions`} class="label">Plätze</label>
        <input id={`${p}-positions`} name="positions" type="number" min="1" max="22" inputmode="numeric" class="input" value={v.positions ?? ''} />
        <p class="field-hint">Nur bei Positions- oder Grid-Strafe.</p>
      </div>
    </div>

    {
      penaltyPointsEnabled && (
        <div class="pp card grid gap-3 p-3" data-pp={ppData}>
          <div class="field max-w-xs" data-for="warning time_penalty position_penalty grid_penalty_next dsq race_ban">
            <label for={`${p}-points`} class="label">
              Strafpunkte
            </label>
            <input
              id={`${p}-points`}
              name="penaltyPoints"
              type="number"
              min="0"
              max="12"
              inputmode="numeric"
              class="input"
              value={v.penaltyPoints ?? ''}
              aria-describedby={`${p}-points-hint ${p}-points-note`}
              data-pp-points
            />
            <p id={`${p}-points-hint`} class="field-hint">
              {penalty
                ? `0–12, leer = keine. Verwarnung ab ${penalty.config.warningThreshold}, Sperre ab ${penalty.config.banThreshold} aktiven Punkten; ${
                    penalty.config.expiryRounds == null ? 'Punkte gelten bis Saisonende' : `Verfall nach ${penalty.config.expiryRounds} Runden`
                  }.`
                : '0–12, leer = keine.'}
            </p>
          </div>
          <div id={`${p}-points-note`} aria-live="polite" data-pp-live>
            {ppNote && <p class={ppAlert[ppNote.level]}>{ppNote.text}</p>}
          </div>
          {penalty && penalty.involved.length > 0 && (
            <div class="table-wrap">
              <table class="timing-table">
                <caption class="pp-caption">Strafpunkte-Konto der Beteiligten ({penalty.seasonName}), ohne diese Entscheidung</caption>
                <thead>
                  <tr>
                    <th scope="col" class="sticky-col">
                      Fahrer
                    </th>
                    <th scope="col" class="num">
                      Aktiv
                    </th>
                    <th scope="col">Status</th>
                    <th scope="col">Nächster Verfall</th>
                  </tr>
                </thead>
                <tbody>
                  {penalty.involved.map((a) => (
                    <tr>
                      <th scope="row" class="sticky-col font-normal">
                        {a.label}
                      </th>
                      <td class="num">{a.active}</td>
                      <td>
                        <span class:list={['badge', a.status === 'ban' ? 'badge-danger' : a.status === 'warning' ? 'badge-warning' : 'badge-muted']}>
                          {ppStatus[a.status]}
                        </span>
                      </td>
                      <td class="pp-muted">{a.nextExpiry ? `${a.nextExpiry.points} Pkt. nach R${a.nextExpiry.afterRound}` : '–'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      )
    }

    {
      catalog.length > 0 && (
        <div class="catalog card p-3">
          <div class="field">
            <label for={`${p}-catalog`} class="label">
              Textbaustein aus dem Strafenkatalog ({CATALOG_NUMBER})
            </label>
            <div class="flex flex-wrap gap-2">
              <select id={`${p}-catalog`} class="select catalog-select" data-catalog>
                {catalog.map((c) => {
                  const s = suggestVerdict(c.standardPenalty);
                  return (
                    <option value={c.code} data-snippet={catalogSnippet(c)} data-verdict={s?.verdict ?? ''} data-seconds={s?.timeSeconds ?? ''}>
                      {c.code} · {c.offence} ({c.standardPenalty})
                    </option>
                  );
                })}
              </select>
              <button type="button" class="btn btn-secondary" data-insert hidden>
                Baustein einfügen
              </button>
            </div>
            <p class="field-hint" data-catalog-hint>
              Fügt den Text in die Begründung ein, setzt die Regel-Referenz und – wenn eindeutig – die Regelstrafe.
            </p>
          </div>
        </div>
      )
    }

    <div class="field">
      <label for={`${p}-de`} class="label">Begründung (Deutsch) <span class="req" aria-hidden="true">*</span></label>
      <textarea id={`${p}-de`} name="reasoningDe" class="textarea" rows="6" required minlength="10" aria-describedby={`${p}-de-hint`} data-reasoning
        >{v.reasoningDe ?? ''}</textarea
      >
      <p id={`${p}-de-hint`} class="field-hint">Markdown möglich. Erscheint öffentlich im Steward-Register; die ersten Sätze gehen als Kurzbegründung nach Discord.</p>
    </div>
    <div class="field">
      <label for={`${p}-en`} class="label">Begründung (Englisch, optional)</label>
      <textarea id={`${p}-en`} name="reasoningEn" class="textarea" rows="4">{v.reasoningEn ?? ''}</textarea>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="field">
        <label for={`${p}-rule`} class="label">Regel-Referenz</label>
        <input id={`${p}-rule`} name="ruleRef" class="input" maxlength="80" placeholder="§8.3 · V-02" value={v.ruleRef ?? ''} data-rule />
      </div>
      <div class="field">
        <label for={`${p}-clip`} class="label">Clip-Link</label>
        <input id={`${p}-clip`} name="clipUrl" type="url" class="input" maxlength="500" placeholder="https://" value={v.clipUrl ?? ''} />
      </div>
    </div>
    <div>
      <button type="submit" class="btn btn-primary">{submitLabel}</button>
    </div>
  </fieldset>
</form>

<script>
  import { penaltyPointsNote } from '~/lib/admin/raceday/decision-input';
  import type { ResolvedPenaltyPointsConfig } from '~/lib/domain/penalty-points';

  const PP_ALERT = { info: 'alert pp-info', warning: 'alert alert-warning pp-strong', ban: 'alert alert-danger pp-strong' } as const;

  // Progressive Verbesserung: Felder je Art ein-/ausblenden, Textbausteine einfügen, Strafpunkte-Warnung
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-decision-form]')) {
    const verdict = form.querySelector<HTMLSelectElement>('[data-verdict]');
    const dependent = form.querySelectorAll<HTMLElement>('[data-for]');

    // Strafpunkte: Warnung live, sobald Fahrer, Art oder Punkte sich ändern
    const pp = form.querySelector<HTMLElement>('[data-pp]');
    let ppData: { config: ResolvedPenaltyPointsConfig; active: Record<string, number>; roundExpired?: boolean } | null = null;
    try {
      ppData = pp?.dataset.pp ? JSON.parse(pp.dataset.pp) : null;
    } catch {
      ppData = null;
    }
    const ppPoints = form.querySelector<HTMLInputElement>('[data-pp-points]');
    const ppLive = form.querySelector<HTMLElement>('[data-pp-live]');
    const driver = form.querySelector<HTMLSelectElement>('select[name="driverId"]');
    const ppUpdate = () => {
      if (!ppData || !ppLive) return;
      const raw = ppPoints && !ppPoints.disabled ? ppPoints.value.trim() : '';
      const points = raw === '' || !Number.isFinite(Number(raw)) ? 0 : Number(raw);
      const note = driver?.value ? penaltyPointsNote(ppData.active[driver.value] ?? 0, points, ppData.config, ppData.roundExpired === true) : null;
      // Nur bei Änderung neu schreiben, sonst liest der Screenreader denselben Text erneut vor
      if ((note?.text ?? '') === (ppLive.textContent ?? '').trim()) return;
      ppLive.replaceChildren();
      if (note) {
        const el = document.createElement('p');
        el.className = PP_ALERT[note.level];
        el.textContent = note.text;
        ppLive.append(el);
      }
    };

    const sync = () => {
      for (const el of dependent) {
        const show = (el.dataset.for ?? '').split(' ').includes(verdict?.value ?? '');
        el.hidden = !show;
        el.querySelectorAll('input').forEach((i) => (i.disabled = !show));
      }
      ppUpdate();
    };
    verdict?.addEventListener('change', sync);
    ppPoints?.addEventListener('input', ppUpdate);
    driver?.addEventListener('change', ppUpdate);
    sync();

    const catalog = form.querySelector<HTMLSelectElement>('[data-catalog]');
    const insert = form.querySelector<HTMLButtonElement>('[data-insert]');
    const reasoning = form.querySelector<HTMLTextAreaElement>('[data-reasoning]');
    const rule = form.querySelector<HTMLInputElement>('[data-rule]');
    if (catalog && insert && reasoning) {
      insert.hidden = false;
      insert.addEventListener('click', () => {
        const opt = catalog.selectedOptions[0];
        if (!opt) return;
        const snippet = opt.dataset.snippet ?? '';
        reasoning.value = reasoning.value.trim() ? `${reasoning.value.trimEnd()}\n\n${snippet}` : snippet;
        if (rule && !rule.value.trim()) rule.value = `§8.3 · ${opt.value}`;
        const suggested = opt.dataset.verdict;
        if (suggested && verdict) {
          verdict.value = suggested;
          const seconds = opt.dataset.seconds;
          const time = form.querySelector<HTMLInputElement>('input[name="timeSeconds"]');
          if (seconds && time) time.value = seconds;
          sync();
        }
        reasoning.focus();
      });
    }
  }
</script>

<style>
  .catalog-select {
    flex: 1;
    min-width: 0;
  }
  fieldset[disabled] {
    opacity: 0.7;
  }
  .pp-caption {
    caption-side: top;
    text-align: left;
    padding: 0 0 0.5rem;
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .pp-muted {
    color: var(--color-muted);
  }
  :global(.pp-strong) {
    font-weight: 700;
  }
  :global(.pp-info) {
    font-size: 0.875rem;
  }
</style>
