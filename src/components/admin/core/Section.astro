---
/** Abschnitt einer Admin-Seite: Karte mit h2, optionaler Beschreibung und Aktionen rechts. */
interface Props {
  title: string;
  id?: string;
  description?: string;
  class?: string;
  /** Überschriftenebene (Standard h2) */
  level?: 2 | 3;
}
const { title, id, description, class: className, level = 2 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---

<section id={id} class:list={['card mb-6 p-4 sm:p-6', className]} aria-labelledby={id ? `${id}-title` : undefined}>
  <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <Heading id={id ? `${id}-title` : undefined} class:list={[level === 2 ? 'text-xl' : 'text-lg', 'uppercase']}>{title}</Heading>
      {description && <p class="mt-1 max-w-prose text-sm text-muted">{description}</p>}
    </div>
    <slot name="actions" />
  </div>
  <slot />
</section>
