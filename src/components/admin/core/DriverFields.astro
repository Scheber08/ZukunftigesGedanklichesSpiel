---
/**
 * Felder eines Fahrers (Plan §5 „Fahrer“, §6.2): öffentliches Profil und private
 * Kontaktdaten (driver_private, nur im Admin sichtbar).
 */
import Field from '~/components/admin/ui/Field.astro';
import CountrySelect from '~/components/admin/core/CountrySelect.astro';
import { DRIVER_STATUS_LABELS, INPUT_DEVICE_LABELS, PLATFORM_LABELS } from '~/lib/admin/league/labels';
import { fieldAria } from '~/lib/admin/league/page';
import { DRIVER_STATUSES, INPUT_DEVICES, PLATFORMS, type SeasonRow } from '~/lib/db/types';

interface Props {
  prefix: string;
  v: (name: string, fallback?: string | number | null) => string;
  checked: (name: string, fallback: boolean) => boolean;
  err: (name: string) => string[] | undefined;
  seasons: SeasonRow[];
  /** Anlegen: Startnummer direkt vergeben; Bearbeiten: Slug, Links, Reserve-Reihenfolge */
  mode: 'create' | 'edit';
}
const { prefix, v, checked, err, seasons, mode } = Astro.props;
const fid = (n: string) => `${prefix}-${n}`;
const aria = (n: string, hint = false) => fieldAria(fid(n), hint, err(n));
---

<fieldset class="grid min-w-0 gap-4 sm:grid-cols-2">
  <legend class="label mb-1 sm:col-span-2">Öffentliches Profil</legend>
  <Field id={fid('gamertag')} label="Gamertag / EA-ID" required hint="Wird normalisiert (Leerzeichen, unsichtbare Zeichen)." error={err('gamertag')}>
    <input id={fid('gamertag')} name="gamertag" class="input" value={v('gamertag')} maxlength="40" required autocomplete="off" {...aria('gamertag', true)} />
  </Field>
  {
    mode === 'edit' ? (
      <Field id={fid('slug')} label="Slug (Profil-URL)" hint="Adresse /fahrer/<slug>. Folgt dem Gamertag, solange du ihn nicht selbst änderst. Alte Adressen leiten per 301 weiter." error={err('slug')}>
        <input id={fid('slug')} name="slug" class="input font-mono" value={v('slug')} maxlength="60" {...aria('slug', true)} />
      </Field>
    ) : (
      <Field id={fid('number')} label="Startnummer (optional)" hint="Gilt sofort. 2–99, die 1 ggf. für den Champion." error={err('number')}>
        <input id={fid('number')} name="number" type="number" min="1" max="99" class="input" value={v('number')} {...aria('number', true)} />
      </Field>
    )
  }
  <Field id={fid('platform')} label="Plattform" required error={err('platform')}>
    <select id={fid('platform')} name="platform" class="select" required {...aria('platform')}>
      {PLATFORMS.map((p) => <option value={p} selected={v('platform') === p}>{PLATFORM_LABELS[p]}</option>)}
    </select>
  </Field>
  <Field id={fid('input_device')} label="Eingabegerät" required error={err('input_device')}>
    <select id={fid('input_device')} name="input_device" class="select" required {...aria('input_device')}>
      {INPUT_DEVICES.map((d) => <option value={d} selected={v('input_device') === d}>{INPUT_DEVICE_LABELS[d]}</option>)}
    </select>
  </Field>
  <Field id={fid('nationality_code')} label="Nationalität (Flagge)" hint="Optional – nur für die Flagge." error={err('nationality_code')}>
    <CountrySelect id={fid('nationality_code')} name="nationality_code" value={v('nationality_code')} describedby={`${fid('nationality_code')}-hint`} />
  </Field>
  <Field id={fid('status')} label="Status" required hint="Reserve = im Reservepool (Warteliste)." error={err('status')}>
    <select id={fid('status')} name="status" class="select" required {...aria('status', true)}>
      {DRIVER_STATUSES.map((s) => <option value={s} selected={v('status') === s}>{DRIVER_STATUS_LABELS[s]}</option>)}
    </select>
  </Field>
  {
    mode === 'edit' && (
      <Field id={fid('reserve_order')} label="Position im Reservepool" hint="Nur bei Status „Reserve“. Leer = ans Ende." error={err('reserve_order')}>
        <input id={fid('reserve_order')} name="reserve_order" type="number" min="1" max="999" class="input" value={v('reserve_order')} {...aria('reserve_order', true)} />
      </Field>
    )
  }
  <Field id={fid('joined_season_id')} label="Dabei seit" error={err('joined_season_id')}>
    <select id={fid('joined_season_id')} name="joined_season_id" class="select" {...aria('joined_season_id')}>
      <option value="">– unbekannt –</option>
      {[...seasons].sort((a, b) => a.number - b.number).map((s) => <option value={s.id} selected={v('joined_season_id') === String(s.id)}>{s.name}</option>)}
    </select>
  </Field>
  {
    mode === 'edit' && (
      <>
        <Field id={fid('twitch_url')} label="Twitch" error={err('twitch_url')}>
          <input id={fid('twitch_url')} name="twitch_url" type="url" class="input" value={v('twitch_url')} placeholder="https://www.twitch.tv/…" {...aria('twitch_url')} />
        </Field>
        <Field id={fid('youtube_url')} label="YouTube" error={err('youtube_url')}>
          <input id={fid('youtube_url')} name="youtube_url" type="url" class="input" value={v('youtube_url')} placeholder="https://www.youtube.com/@…" {...aria('youtube_url')} />
        </Field>
        <label class="checkbox sm:col-span-2" for={fid('show_links')}>
          <input id={fid('show_links')} type="checkbox" name="show_links" value="true" checked={checked('show_links', false)} />
          <span>Links im öffentlichen Profil zeigen (nur mit Zustimmung des Fahrers)</span>
        </label>
      </>
    )
  }
</fieldset>

<fieldset class="mt-6 grid min-w-0 gap-4 rounded-lg border border-border p-4 sm:grid-cols-2">
  <legend class="label px-1">Privat – nur im Admin sichtbar</legend>
  <Field id={fid('discord_username')} label="Discord-Name" error={err('discord_username')}>
    <input id={fid('discord_username')} name="discord_username" class="input" value={v('discord_username')} maxlength="64" autocomplete="off" {...aria('discord_username')} />
  </Field>
  <Field id={fid('discord_user_id')} label="Discord-ID" hint="Für die Staff-Verknüpfung (Befangenheit). Entwicklermodus → „ID kopieren“." error={err('discord_user_id')}>
    <input id={fid('discord_user_id')} name="discord_user_id" class="input font-mono" inputmode="numeric" value={v('discord_user_id')} maxlength="21" autocomplete="off" {...aria('discord_user_id', true)} />
  </Field>
  <Field id={fid('ea_id')} label="EA-ID" error={err('ea_id')}>
    <input id={fid('ea_id')} name="ea_id" class="input" value={v('ea_id')} maxlength="64" autocomplete="off" {...aria('ea_id')} />
  </Field>
  <Field id={fid('notes')} label="Notizen" error={err('notes')} class="sm:col-span-2">
    <textarea id={fid('notes')} name="notes" class="textarea" rows="3" maxlength="4000" {...aria('notes')}>{v('notes')}</textarea>
  </Field>
</fieldset>
