---
/**
 * Kurz erklärt: Frist, Videobeweis, Befangenheit, Veröffentlichung (Plan §4.6, Regelwerk §7).
 * Die Paragraphen-Links kommen aus dem gültigen Regelwerk (siehe ./rules.ts).
 */
import Clock from '@lucide/astro/icons/clock';
import Eye from '@lucide/astro/icons/eye';
import Scale from '@lucide/astro/icons/scale';
import Video from '@lucide/astro/icons/video';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import { useT, type Lang } from '~/i18n';
import type { ProcedureKey, RuleLink } from './rules';

interface Props {
  lang: Lang;
  /** Protestfrist der aktuellen Saison in Stunden */
  hours: number;
  links: { root: RuleLink; items: Record<ProcedureKey, RuleLink> };
  headingId?: string;
}
const { lang, hours, links, headingId = 'procedure-title' } = Astro.props;
const t = useT(lang);
const items = [
  { key: 'deadline', icon: Clock },
  { key: 'evidence', icon: Video },
  { key: 'conflict', icon: Scale },
  { key: 'publication', icon: Eye },
] as const;
---

<section aria-labelledby={headingId}>
  <SectionTitle id={headingId} title={t('stewards.procedure.title')} href={links.root.href} linkLabel={t('stewards.procedure.rulesLink')} />
  <p class="-mt-2 mb-5 max-w-2xl text-muted">{t('stewards.procedure.lead')}</p>
  <ul class="grid gap-4 sm:grid-cols-2">
    {
      items.map(({ key, icon: Icon }) => {
        const rule = links.items[key];
        const title = t(`stewards.procedure.${key}.title`);
        return (
          <li class="card p-5">
            <h3 class="flex items-center gap-2.5 text-lg uppercase">
              <span class="text-teal">
                <Icon size={20} aria-hidden="true" />
              </span>
              {title}
            </h3>
            <p class="mt-2 text-sm text-muted">{t(`stewards.procedure.${key}.text`, { hours })}</p>
            {rule.number && (
              <a href={rule.href} class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-green hover:text-teal">
                {t('stewards.procedure.sectionLink', { n: rule.number })}
                <span class="sr-only"> – {title}</span>
                <span aria-hidden="true">&nbsp;→</span>
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</section>
