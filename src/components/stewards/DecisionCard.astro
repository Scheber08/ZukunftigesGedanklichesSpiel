---
/**
 * Eintrag im Steward-Register: Referenz, Runde, Session, bestrafter Fahrer, Entscheidung,
 * Strafe, Kurzbegründung, Clip-Link und Datum (Plan §4.6).
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import BookOpen from '@lucide/astro/icons/book-open';
import Video from '@lucide/astro/icons/video';
import DriverLink from '~/components/ui/DriverLink.astro';
import { url, useT, type Lang } from '~/i18n';
import { formatDate } from '~/lib/domain/time';
import { roundLabel, seasonLabel } from '~/lib/view';
import type { DecisionItem } from './model';
import { penaltyOf, plainExcerpt } from './utils';
import VerdictBadge from './VerdictBadge.astro';

interface Props {
  lang: Lang;
  item: DecisionItem;
  /** Saison im Kopf zeigen (Register über mehrere Saisons) */
  showSeason?: boolean;
}
const { lang, item, showSeason = true } = Astro.props;
const t = useT(lang);
const { decision: d, round, track, season, sessionType, driver, team, number, rule, clipUrl } = item;
const penalty = penaltyOf(d);
const detailHref = url(lang, 'decision', { ref: d.public_ref });
const raceHref = url(lang, 'race', { season: season.slug, round: round.number });
const excerpt = plainExcerpt(item.reasoning.text, 220);
const headingId = `d-${d.public_ref.toLowerCase()}`;
---

<article class="decision card" aria-labelledby={headingId}>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <div class="flex flex-wrap items-center gap-3">
      <h3 id={headingId} class="ref tabular">
        <a href={detailHref}>{d.public_ref}</a>
      </h3>
      <VerdictBadge verdict={d.verdict} lang={lang} />
    </div>
    {
      d.published_at && (
        <p class="text-sm text-muted">
          <span class="sr-only">{t('stewards.field.date')}: </span>
          <time datetime={d.published_at}>{formatDate(d.published_at, lang)}</time>
        </p>
      )
    }
  </div>

  <p class="mt-2 text-sm text-muted">
    <a href={raceHref} class="font-semibold text-fg hover:text-teal">{roundLabel(round, track, lang)}</a>
    <span aria-hidden="true"> · </span>
    <span class="sr-only">, {t('stewards.field.session')}: </span>{t(`session.${sessionType}`)}
    {
      showSeason && (
        <>
          <span aria-hidden="true"> · </span>
          <span class="sr-only">, </span>
          {seasonLabel(season, lang)}
        </>
      )
    }
  </p>

  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
    <DriverLink lang={lang} driver={driver} team={team} number={number} />
    {
      item.involved.length > 0 && (
        <p class="text-sm text-muted">
          {t('stewards.field.involved')}: {item.involved.map((x) => x.driver ? (x.driver.anonymized ? t('common.formerDriver') : x.driver.gamertag) : '–').join(', ')}
        </p>
      )
    }
    <p class="penalty text-sm">
      <span class="sr-only">{t('stewards.field.penalty')}: </span>
      {t(penalty.key, { n: penalty.n ?? '' })}
    </p>
  </div>

  {
    excerpt && (
      <p class="mt-3 text-sm text-muted" lang={item.reasoning.fallback ? 'de' : undefined}>
        {excerpt}
      </p>
    )
  }

  <ul class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
    <li>
      <a href={detailHref} class="link-action">
        {t('stewards.details')}
        <span class="sr-only"> – {t('stewards.detailsFor', { ref: d.public_ref })}</span>
        <ArrowRight size={16} aria-hidden="true" />
      </a>
    </li>
    {
      clipUrl && (
        <li>
          <a href={clipUrl} class="link-action" target="_blank" rel="noopener noreferrer">
            <Video size={16} aria-hidden="true" />
            {t('stewards.clip')}
            <span class="sr-only">
              {' '}
              – {t('stewards.clipFor', { ref: d.public_ref })} {t('a11y.externalLink')}
            </span>
          </a>
        </li>
      )
    }
    {
      d.rule_ref && rule && (
        <li>
          <a href={rule.href} class="link-action">
            <BookOpen size={16} aria-hidden="true" />
            <span class="sr-only">{t('stewards.field.rule')}: </span>
            {d.rule_ref}
          </a>
        </li>
      )
    }
  </ul>
</article>

<style>
  .decision {
    padding: 1.125rem 1.25rem;
  }
  .ref {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .ref a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .ref a:hover {
    color: var(--color-teal);
    text-decoration: underline;
  }
  .penalty {
    font-weight: 600;
  }
  .link-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    font-weight: 600;
    color: var(--color-green);
  }
  .link-action:hover {
    color: var(--color-teal);
    text-decoration: underline;
  }
</style>
