---
/**
 * Countdown zum nächsten Rennen (Plan §3.5, §4.2): Tage, Std., Min., Sek. in großen
 * Tabular-Ziffern. Kein sekündliches aria-live – der Termin steht als Text daneben.
 * Die Ziffern wechseln nur (kein Kippen); der Verlauf-Balken zeigt den Fortschritt seit dem
 * letzten Rennen. Bewusst ohne Framework (wenige Zeilen Skript statt Svelte-Laufzeit, Plan §10).
 */

interface Target {
  startUtc: string;
  label: string;
  href: string;
  dateText: string;
}

interface Props {
  targets: Target[];
  /** Start des letzten Rennens – Basis für den Fortschrittsbalken */
  previousStartUtc?: string | null;
  labels: { days: string; hours: string; minutes: string; seconds: string; next: string; now: string; none: string };
  /** Rundenbezeichnung verlinken (auf der Rennseite selbst: false) */
  linkTarget?: boolean;
  /** Zeile „Nächstes Rennen“ zeigen (aus, wenn die Umgebung schon eine Überschrift hat) */
  showLabel?: boolean;
}

const { targets, previousStartUtc = null, labels, linkTarget = true, showLabel = true } = Astro.props;
const first = targets[0];
const units = [labels.days, labels.hours, labels.minutes, labels.seconds];
---

{
  first ? (
    <div class="countdown" data-countdown data-targets={JSON.stringify(targets)} data-previous={previousStartUtc ?? ''}>
      {showLabel && <p class="micro">{labels.next}</p>}
      {linkTarget ? (
        <a class="target" href={first.href} data-cd-label>
          {first.label}
        </a>
      ) : (
        <p class="target" data-cd-label>
          {first.label}
        </p>
      )}
      <p class="date" data-cd-date>
        {first.dateText}
      </p>
      <p class="live" data-cd-live hidden>
        <span class="live-dot" aria-hidden="true" />
        {labels.now}
      </p>
      <div class="digits" aria-hidden="true" data-cd-digits>
        {units.map((unit, i) => (
          <div class="unit">
            <span class="value" data-cd-value={i}>
              ––
            </span>
            <span class="label">{unit}</span>
          </div>
        ))}
      </div>
      <div class="bar" aria-hidden="true">
        <span data-cd-bar />
      </div>
      <p class="text-muted" data-cd-none hidden>
        {labels.none}
      </p>
    </div>
  ) : (
    <p class="text-muted">{labels.none}</p>
  )
}

<style>
  .countdown {
    display: grid;
    gap: 0.35rem;
  }
  .target {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-decoration: none;
  }
  a.target:hover {
    color: var(--color-teal);
  }
  .date {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .digits {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .digits[hidden] {
    display: none;
  }
  .unit {
    display: grid;
    justify-items: center;
    /* passt ab 320 px: Blöcke teilen sich die Breite */
    flex: 1 1 0;
    min-width: 0;
    max-width: 6.5rem;
    padding: 0.5rem 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: rgb(14 14 16 / 0.8);
  }
  .value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 1.6rem + 2vw, 3rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .label {
    margin-top: 0.3rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .bar {
    height: 2px;
    margin-top: 0.75rem;
    background: var(--color-border);
    border-radius: 2px;
    overflow: hidden;
  }
  .bar span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--g-accent);
  }
  .live {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-teal);
  }
  .live[hidden] {
    display: none;
  }
</style>

<script>
  interface Target {
    startUtc: string;
    label: string;
    href: string;
    dateText: string;
  }

  /** Ein Rennen gilt bis 3 Stunden nach dem Start als „läuft gerade“. */
  const LIVE_WINDOW_MS = 3 * 3_600_000;

  function initCountdown(root: HTMLElement) {
    let targets: Target[] = [];
    try {
      targets = JSON.parse(root.dataset.targets ?? '[]') as Target[];
    } catch {
      return;
    }
    const previous = root.dataset.previous ? Date.parse(root.dataset.previous) : Number.NaN;
    const label = root.querySelector<HTMLElement>('[data-cd-label]');
    const date = root.querySelector<HTMLElement>('[data-cd-date]');
    const live = root.querySelector<HTMLElement>('[data-cd-live]');
    const digits = root.querySelector<HTMLElement>('[data-cd-digits]');
    const bar = root.querySelector<HTMLElement>('[data-cd-bar]');
    const none = root.querySelector<HTMLElement>('[data-cd-none]');
    const values = [...root.querySelectorAll<HTMLElement>('[data-cd-value]')];
    let current: Target | undefined;

    const tick = () => {
      const now = Date.now();
      const target = targets.find((t) => Date.parse(t.startUtc) > now - LIVE_WINDOW_MS);
      if (!target) {
        root.querySelectorAll<HTMLElement>(':scope > :not([data-cd-none])').forEach((el) => (el.hidden = true));
        if (none) none.hidden = false;
        return;
      }
      if (target !== current) {
        current = target;
        if (label) {
          label.textContent = target.label;
          if (label instanceof HTMLAnchorElement) label.href = target.href;
        }
        if (date) date.textContent = target.dateText;
      }
      const start = Date.parse(target.startUtc);
      const diff = Math.max(0, start - now);
      const isLive = diff === 0;
      if (live) live.hidden = !isLive;
      if (digits) digits.hidden = isLive;
      const s = Math.floor(diff / 1000);
      const parts = [Math.floor(s / 86400), Math.floor((s % 86400) / 3600), Math.floor((s % 3600) / 60), s % 60];
      parts.forEach((v, i) => {
        const text = String(v).padStart(2, '0');
        const el = values[i];
        if (el && el.textContent !== text) el.textContent = text;
      });
      if (bar && Number.isFinite(previous) && start > previous) {
        const progress = Math.min(1, Math.max(0, (now - previous) / (start - previous)));
        bar.style.width = `${Math.round(progress * 100)}%`;
      }
    };

    tick();
    window.setInterval(tick, 1000);
  }

  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach(initCountdown);
</script>
