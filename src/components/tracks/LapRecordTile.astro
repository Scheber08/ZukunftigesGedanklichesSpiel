---
/**
 * Zeit-Rekord einer Strecke (schnellste Rennrunde bzw. beste Qualifying-Zeit): Zeit groß,
 * darunter Fahrer (mit Teamstreifen) und die Runde mit Link zur Rennseite.
 */
import DriverLink from '~/components/ui/DriverLink.astro';
import { url, useT, type Lang } from '~/i18n';
import { formatLapTime } from '~/lib/domain/laptime';
import type { League } from '~/lib/league/league';
import type { LapRecord } from '~/lib/tracks';
import { roundLabel, seasonLabel } from '~/lib/view';

interface Props {
  lang: Lang;
  league: League;
  label: string;
  record: LapRecord | null;
}
const { lang, league, label, record } = Astro.props;
const t = useT(lang);
---

<div class="record-tile">
  <dt class="micro">{label}</dt>
  {
    record ? (
      <dd class="grid gap-1">
        <span class="record-value tabular">{formatLapTime(record.ms)}</span>
        <DriverLink lang={lang} driver={league.driver(record.result.driver_id)} team={league.team(record.result.team_id)} />
        <span class="text-sm text-muted">
          <a href={url(lang, 'race', { season: record.season.slug, round: record.round.number })} class="record-round">
            {roundLabel(record.round, league.track(record.round.track_id), lang)}
          </a>{' '}
          · {seasonLabel(record.season, lang)}
          {record.sessionType === 'sprint' && <> · {t('session.sprint')}</>}
        </span>
      </dd>
    ) : (
      <dd class="text-muted">{t('tracks.records.none')}</dd>
    )
  }
</div>

<style>
  .record-tile {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-1);
    min-width: 0;
  }
  .record-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1.1;
  }
  .record-round {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--color-fg);
    text-decoration: none;
  }
  .record-round:hover {
    color: var(--color-teal);
    text-decoration: underline;
  }
</style>
