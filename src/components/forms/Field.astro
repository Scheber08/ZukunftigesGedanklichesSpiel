---
/**
 * Formularfeld mit Label, Hinweis und Fehlertext unter dem Feld (WCAG 3.3.1/3.3.2):
 * aria-invalid + aria-describedby verweisen auf Hinweis und Fehler.
 */
import CircleAlert from '@lucide/astro/icons/circle-alert';
import { useT, type Lang } from '~/i18n';

type InputType = 'text' | 'email' | 'number' | 'url' | 'textarea';

interface Props {
  lang: Lang;
  name: string;
  label: string;
  id?: string;
  type?: InputType;
  value?: string | number | null;
  required?: boolean;
  hint?: string;
  error?: string | null;
  autocomplete?: string;
  inputmode?: 'text' | 'numeric' | 'email' | 'url' | 'search' | 'tel' | 'decimal' | 'none';
  min?: number;
  max?: number;
  step?: number;
  minlength?: number;
  maxlength?: number;
  placeholder?: string;
  rows?: number;
  spellcheck?: boolean;
  /** Zusätzliche ID für aria-describedby (z. B. Live-Status der Nummernprüfung) */
  describedby?: string;
  /** Weitere Attribute für das Eingabefeld (z. B. data-*) */
  attrs?: Record<string, string | number | boolean | undefined>;
  class?: string;
}

const {
  lang,
  name,
  label,
  id = `f-${name}`,
  type = 'text',
  value,
  required = false,
  hint,
  error,
  autocomplete,
  inputmode,
  min,
  max,
  step,
  minlength,
  maxlength,
  placeholder,
  rows = 5,
  spellcheck,
  describedby,
  attrs = {},
  class: className,
} = Astro.props;
const t = useT(lang);
const hintId = hint ? `${id}-hint` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [hintId, describedby, errorId].filter(Boolean).join(' ') || undefined;
const common = {
  id,
  name,
  required,
  autocomplete,
  placeholder,
  minlength,
  maxlength,
  spellcheck: spellcheck === undefined ? undefined : spellcheck ? ('true' as const) : ('false' as const),
  'aria-invalid': error ? ('true' as const) : undefined,
  'aria-describedby': describedBy,
  ...attrs,
};
---

<div class:list={['field', className]}>
  <label for={id} class="label">
    {label}
    {
      required ? (
        <span class="req" aria-hidden="true">
          {' '}*
        </span>
      ) : (
        <span class="font-normal text-muted"> ({t('forms.optional')})</span>
      )
    }
  </label>
  {
    type === 'textarea' ? (
      <textarea class="textarea" rows={rows} {...common}>
        {value ?? ''}
      </textarea>
    ) : (
      <input class="input" type={type} value={value ?? undefined} inputmode={inputmode} min={min} max={max} step={step} {...common} />
    )
  }
  {hint && <p id={hintId} class="field-hint">{hint}</p>}
  <slot />
  {
    error && (
      <p id={errorId} class="field-error flex items-start gap-1.5">
        <CircleAlert size={16} class="mt-0.5 shrink-0" aria-hidden="true" />
        <span>{error}</span>
      </p>
    )
  }
</div>
