---
/** Farblegende: Pole, schnellste Runde, DNF, Reserve – immer mit Kürzel/Icon (Plan §3.2). */
import Timer from '@lucide/astro/icons/timer';
import { useT, type Lang } from '~/i18n';
interface Props {
  lang: Lang;
  podium?: boolean;
}
const { lang, podium = false } = Astro.props;
const t = useT(lang);
---

<dl class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-muted" aria-label={t('legend.title')}>
  <div class="flex items-center gap-1.5"><dt class="pole-mark">P</dt><dd>{t('legend.pole')}</dd></div>
  <div class="flex items-center gap-1.5"><dt class="text-teal"><Timer size={14} aria-hidden="true" /><span class="sr-only">FL</span></dt><dd>{t('legend.fastestLap')}</dd></div>
  <div class="flex items-center gap-1.5"><dt class="font-bold text-danger">DNF</dt><dd>{t('legend.dnf')}</dd></div>
  <div class="flex items-center gap-1.5"><dt class="reserve-chip">R</dt><dd>{t('legend.reserve')}</dd></div>
  {podium && <div class="flex items-center gap-1.5"><dt class="podium-chip">1–3</dt><dd>{t('legend.podium')}</dd></div>}
</dl>

<style>
  .pole-mark {
    font-weight: 800;
    color: var(--color-green);
  }
  .reserve-chip,
  .podium-chip {
    padding: 0 0.3rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    font-weight: 700;
  }
  .podium-chip {
    background: rgb(55 190 137 / 0.15);
    color: var(--color-fg);
  }
</style>
