---
/** H2 mit Tropfen-Marke (Motiv aus dem Logo) und optionalem Link rechts. */
interface Props {
  title: string;
  id?: string;
  href?: string;
  linkLabel?: string;
  as?: 'h2' | 'h3';
  class?: string;
}
const { title, id, href, linkLabel, as: Tag = 'h2', class: className } = Astro.props;
---

<div class:list={['mb-6 flex flex-wrap items-center justify-between gap-3', className]}>
  <Tag class="section-title uppercase" id={id}>{title}</Tag>
  {href && linkLabel && <a href={href} class="text-sm font-semibold text-green hover:text-teal">{linkLabel} →</a>}
</div>
