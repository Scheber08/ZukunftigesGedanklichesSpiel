---
/** Marken-Icons (Simple Icons, CC0) – nur als Link zu unseren Profilen. */
import { siDiscord, siInstagram, siTiktok, siTwitch, siYoutube } from 'simple-icons';

const ICONS = { discord: siDiscord, instagram: siInstagram, tiktok: siTiktok, youtube: siYoutube, twitch: siTwitch };

interface Props {
  name: keyof typeof ICONS;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
const icon = ICONS[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  class={className}
  aria-hidden="true"
  focusable="false"><path d={icon.path}></path></svg
>
