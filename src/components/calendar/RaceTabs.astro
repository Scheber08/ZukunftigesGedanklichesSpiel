---
/**
 * Zugängliche Tabs mit progressiver Verbesserung (Plan §4.3):
 * Ohne JS stehen alle Panels untereinander (mit eigener Überschrift), die Tab-Leiste
 * bleibt verborgen. Mit JS werden daraus role=tablist/tab/tabpanel mit Pfeiltasten,
 * Pos1/Ende und dem URL-Fragment (#rennen) als Einstieg.
 * Die Panels liefert der Slot (<RaceTabPanel id=…>), die IDs müssen zu `tabs` passen.
 */
interface Props {
  tabs: Array<{ id: string; label: string; count?: number | null }>;
  /** ID des Standard-Tabs */
  defaultId: string;
  /** Beschriftung der Tab-Leiste */
  label: string;
  class?: string;
}
const { tabs, defaultId, label, class: className } = Astro.props;
---

<div class:list={['race-tabs', className]} data-race-tabs data-default={defaultId}>
  <div class="tabs race-tablist" data-tablist aria-label={label} hidden>
    {
      tabs.map((tab) => (
        <button type="button" class="tab" id={`tab-${tab.id}`} data-tab={tab.id} aria-controls={tab.id}>
          {tab.label}
          {tab.count != null && tab.count > 0 && <span class="tab-count tabular">{tab.count}</span>}
        </button>
      ))
    }
  </div>
  <div class="race-panels">
    <slot />
  </div>
</div>

<style>
  .race-tablist[hidden] {
    display: none;
  }
  .race-tablist {
    position: sticky;
    top: var(--header-h, 0px);
    z-index: 5;
    background: var(--color-bg);
  }
  .tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.35rem;
    height: 1.35rem;
    margin-left: 0.4rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--color-muted);
  }
  .race-panels {
    display: grid;
    gap: 3rem;
  }
  .is-enhanced .race-panels {
    display: block;
    margin-top: 1.5rem;
  }
  .is-enhanced :global([data-tab-panel][hidden]) {
    display: none;
  }
  .is-enhanced :global([data-tab-panel]:focus-visible) {
    outline: 2px solid var(--color-teal);
    outline-offset: 4px;
    border-radius: 4px;
  }
</style>

<script>
  // Tabs nach dem WAI-ARIA-Muster (automatische Aktivierung)
  document.querySelectorAll<HTMLElement>('[data-race-tabs]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[data-tablist]');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = tabs.map((tab) => document.getElementById(tab.dataset.tab ?? ''));
    if (!list || tabs.length === 0 || panels.some((p) => p == null)) return;

    list.setAttribute('role', 'tablist');
    list.hidden = false;
    root.classList.add('is-enhanced');

    tabs.forEach((tab, i) => {
      const panel = panels[i]!;
      tab.setAttribute('role', 'tab');
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tab.id);
      panel.tabIndex = 0;
    });

    function select(index: number, opts: { focus?: boolean; updateHash?: boolean } = {}) {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i]!.hidden = !active;
      });
      const tab = tabs[index]!;
      if (opts.focus) tab.focus();
      if (opts.updateHash && tab.dataset.tab) history.replaceState(null, '', `#${tab.dataset.tab}`);
      // aktiven Tab in der (horizontal scrollbaren) Leiste sichtbar halten, ohne die Seite zu bewegen
      const left = tab.offsetLeft;
      const right = left + tab.offsetWidth;
      if (left < list!.scrollLeft) list!.scrollLeft = left;
      else if (right > list!.scrollLeft + list!.clientWidth) list!.scrollLeft = right - list!.clientWidth;
    }

    const indexOf = (id: string | undefined | null) => tabs.findIndex((t) => t.dataset.tab === id);

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, { updateHash: true }));
      tab.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        select(next, { focus: true, updateHash: true });
      });
    });

    // Einstieg: #fragment aus der URL, sonst der Standard-Tab
    const fromHash = indexOf(decodeURIComponent(location.hash.slice(1)));
    const initial = fromHash >= 0 ? fromHash : Math.max(0, indexOf(root.dataset.default));
    select(initial);
    if (fromHash >= 0) list.scrollIntoView({ block: 'start' });

    window.addEventListener('hashchange', () => {
      const i = indexOf(decodeURIComponent(location.hash.slice(1)));
      if (i >= 0) select(i);
    });
  });
</script>
