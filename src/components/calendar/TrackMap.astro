---
/**
 * Streckenkarte (Plan §7.5): SVG-Umriss aus `tracks.map_url` als <img> mit Alt-Text
 * und Quellen-/Lizenzangabe aus `tracks.map_credit`. Ohne gepflegte Karte wird nichts
 * ausgegeben. Feste Maße (8:5) verhindern Layout-Verschiebungen; der Umriss wird
 * eingepasst (object-fit: contain), sollte also für den dunklen Hintergrund hell sein.
 */
import { useT, type Lang } from '~/i18n';
import { trackMapImage } from '~/lib/calendar/race';
import type { TrackRow } from '~/lib/db/types';
import { trackName } from '~/lib/view';

interface Props {
  lang: Lang;
  track: TrackRow | undefined;
  /** Oberhalb des sichtbaren Bereichs sofort laden (Kopf der Rennseite) */
  eager?: boolean;
  class?: string;
}
const { lang, track, eager = false, class: className } = Astro.props;
const t = useT(lang);
const map = trackMapImage(track);
---

{
  map && (
    <figure class:list={['track-map', className]}>
      <img
        src={map.src}
        alt={t('calendar.track.mapAlt', { track: trackName(track, lang) })}
        width="320"
        height="200"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        referrerpolicy="no-referrer"
      />
      {map.credit && <figcaption class="track-map-credit">{t('calendar.track.mapCredit', { credit: map.credit })}</figcaption>}
    </figure>
  )
}

<style>
  .track-map {
    margin: 0;
    min-width: 0;
  }
  .track-map img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: contain;
  }
  .track-map-credit {
    margin-top: 0.375rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }
</style>
