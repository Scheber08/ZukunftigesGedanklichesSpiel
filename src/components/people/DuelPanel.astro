---
/**
 * Teamkollegen-Duell (Plan §4.5): Qualifying, Rennen und Punkte Kopf an Kopf,
 * dazu Runde für Runde als Tabelle. Balken sind nur Deko, die Zahlen stehen immer daneben.
 * DNF/DSQ/DNS stehen als Text in der Tabelle; ein gewerteter Fahrer schlägt einen
 * ausgefallenen, sind beide ausgefallen, steht dort „Kein Duell“ (src/lib/people/duel.ts).
 */
import DriverLink from '~/components/ui/DriverLink.astro';
import { useT, type Lang } from '~/i18n';
import type { DriverRow, TeamRow } from '~/lib/db/types';
import type { DuelCell, SessionDuel } from '~/lib/domain/h2h';
import type { Duel } from '~/lib/domain/stats';
import type { League } from '~/lib/league/league';
import { duelDetail, isNoDuel } from '~/lib/people/duel';
import { roundLabel, teamStyle } from '~/lib/view';

interface Props {
  lang: Lang;
  league: League;
  id: string;
  a: DriverRow;
  b: DriverRow;
  team: TeamRow;
  duel: Duel;
}
const { lang, league, id, a, b, team, duel } = Astro.props;
const t = useT(lang);
const nameA = league.driverName(a.id, lang);
const nameB = league.driverName(b.id, lang);

// Runde für Runde mit Status (dieselben Runden wie das Duell)
const duelRounds = new Set(duel.rounds.map((r) => r.roundId));
const detail = duelDetail(
  league.standingsResults().filter((r) => duelRounds.has(r.roundId)),
  duel.teamId,
  duel.driverA,
  duel.driverB,
  (roundId) => {
    const round = league.round(roundId);
    return round ? new Date(round.start_utc).getTime() : 0;
  },
);
const rows = [
  { key: 'qualifying', label: t('session.qualifying'), x: detail.qualiWinsA, y: detail.qualiWinsB, none: detail.qualiNoDuel },
  { key: 'race', label: t('session.race'), x: detail.raceWinsA, y: detail.raceWinsB, none: detail.raceNoDuel },
  { key: 'points', label: t('common.points'), x: duel.pointsA, y: duel.pointsB, none: 0 },
];
const share = (x: number, y: number) => (x + y === 0 ? 50 : Math.round((x / (x + y)) * 100));
const cellText = (c: DuelCell | null) =>
  c == null ? t('people.duel.notStarted') : c.position != null ? t('people.pos', { n: c.position }) : t(`status.result.${c.status}`);
const out = (c: DuelCell | null) => c != null && c.position == null;
const statusOf = (c: DuelCell | null) => (c ? t(`status.result.${c.status}`) : '–');
const sessions = (r: (typeof detail.rounds)[number]): SessionDuel[] => [r.quali, r.race];
---

<div class="duel card p-4 md:p-5" style={teamStyle(team)}>
  <div class="duel-head">
    <DriverLink lang={lang} driver={a} team={team} stripe={false} class="text-base" />
    <span class="micro">{t('people.duel.versus')}</span>
    <DriverLink lang={lang} driver={b} team={team} stripe={false} class="justify-end text-base" />
  </div>
  <p class="mt-1 text-xs text-muted">{t('people.duel.lead', { team: team.name })}</p>

  {
    detail.rounds.length === 0 ? (
      <p class="mt-4 text-sm text-muted">{t('people.duel.none')}</p>
    ) : (
      <>
        <dl class="mt-4 grid gap-3">
          {rows.map((r) => (
            <div class="duel-row">
              <dt class="micro text-center">{r.label}</dt>
              <dd class="duel-values">
                <span class:list={['v tabular', r.x > r.y && 'lead']}>{r.x}</span>
                <span class="bar" aria-hidden="true">
                  <span class="bar-a" style={`width: ${share(r.x, r.y)}%`} />
                  <span class="bar-b" />
                </span>
                <span class:list={['v tabular text-right', r.y > r.x && 'lead']}>{r.y}</span>
                <span class="sr-only">{t('people.duel.score', { a: nameA, x: r.x, b: nameB, y: r.y })}</span>
              </dd>
              {r.none > 0 && <dd class="text-center text-xs text-muted">{t('people.duel.noDuelCount', { n: r.none })}</dd>}
            </div>
          ))}
        </dl>
        <details class="mt-3">
          <summary class="summary text-sm text-muted">{t('people.duel.rounds')}</summary>
          <div class="table-wrap mt-3">
            <table class="timing-table" id={`${id}-rounds`}>
              <caption class="sr-only">{t('people.duel.caption', { a: nameA, b: nameB })}</caption>
              <thead>
                <tr>
                  <th scope="col" class="sticky-col" rowspan="2">
                    {t('common.round')}
                  </th>
                  <th scope="colgroup" colspan="2" class="text-center">
                    {t('session.qualifying')}
                  </th>
                  <th scope="colgroup" colspan="2" class="text-center">
                    {t('session.race')}
                  </th>
                </tr>
                <tr>
                  <th scope="col" class="num">{nameA}</th>
                  <th scope="col" class="num">{nameB}</th>
                  <th scope="col" class="num">{nameA}</th>
                  <th scope="col" class="num">{nameB}</th>
                </tr>
              </thead>
              <tbody>
                {detail.rounds.map((r) => {
                  const round = league.round(r.roundId);
                  return (
                    <tr>
                      <th scope="row" class="sticky-col font-normal">
                        {round ? roundLabel(round, league.track(round.track_id), lang) : '–'}
                      </th>
                      {sessions(r).map((d) =>
                        isNoDuel(d) ? (
                          <td colspan="2" class="no-duel">
                            <span class="font-semibold">{t('people.duel.noDuel')}</span>
                            <span class="text-danger" aria-hidden="true">
                              {' '}
                              ({statusOf(d.a)} · {statusOf(d.b)})
                            </span>
                            <span class="sr-only">
                              : {t('people.duel.bothOut', { a: `${nameA} ${statusOf(d.a)}`, b: `${nameB} ${statusOf(d.b)}` })}
                            </span>
                          </td>
                        ) : (
                          <>
                            <td class:list={['num', d.winner === 'a' && 'win', out(d.a) && 'text-danger', d.a == null && 'muted']}>
                              {cellText(d.a)}
                              {d.winner === 'a' && <span class="sr-only"> ({t('people.duel.ahead')})</span>}
                            </td>
                            <td class:list={['num', d.winner === 'b' && 'win', out(d.b) && 'text-danger', d.b == null && 'muted']}>
                              {cellText(d.b)}
                              {d.winner === 'b' && <span class="sr-only"> ({t('people.duel.ahead')})</span>}
                            </td>
                          </>
                        ),
                      )}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </details>
      </>
    )
  }
</div>

<style>
  .duel {
    min-width: 0;
    border-left: 4px solid var(--team-color, var(--color-border));
  }
  .duel-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
  }
  .duel-row {
    display: grid;
    gap: 0.25rem;
  }
  .duel-values {
    display: grid;
    grid-template-columns: 3.5rem 1fr 3.5rem;
    align-items: center;
    gap: 0.75rem;
  }
  .v {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-muted);
  }
  .v.lead {
    color: var(--color-fg);
  }
  .bar {
    display: flex;
    height: 0.5rem;
    border-radius: 999px;
    overflow: hidden;
    background: var(--color-surface-2);
  }
  .bar-a {
    background: var(--color-green);
  }
  .bar-b {
    flex: 1;
    background: var(--color-teal-deep);
  }
  .win {
    font-weight: 700;
    color: var(--color-fg);
    box-shadow: inset 0 -2px 0 var(--color-green);
  }
  .no-duel {
    text-align: center;
    color: var(--color-muted);
  }
  .summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
  }
</style>
