---
/** Sprungmarken „Auf dieser Seite“ für lange Profilseiten (als Chips, auch mobil gut bedienbar). */
import { useT, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  items: Array<{ id: string; label: string }>;
}
const { lang, items } = Astro.props;
const t = useT(lang);
---

{
  items.length > 1 && (
    <nav aria-label={t('people.onThisPage')} class="section-nav no-print">
      <ul>
        {items.map((item) => (
          <li>
            <a href={`#${item.id}`}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .section-nav {
    margin-top: 1.5rem;
  }
  .section-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .section-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.25rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-1);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
    transition:
      color 150ms ease-out,
      border-color 150ms ease-out;
  }
  .section-nav a:hover {
    color: var(--color-fg);
    border-color: var(--color-teal);
  }
</style>
