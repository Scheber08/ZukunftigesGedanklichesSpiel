---
/** Inhaltsverzeichnis des Regelwerks (Kapitel + Paragraphen), verlinkt auf die Anker. */
import type { Lang } from '~/i18n';
import { localized, type RuleNode } from '~/lib/league/league';

interface Props {
  lang: Lang;
  tree: RuleNode[];
}
const { lang, tree } = Astro.props;
const label = (node: RuleNode) => localized(node, 'title', lang);
---

<ol class="toc-list">
  {
    tree.map((chapter) => (
      <li data-toc-item={chapter.anchor}>
        <a href={`#${chapter.anchor}`} class="toc-link toc-chapter" data-toc-link={chapter.anchor}>
          <span class="toc-num">{chapter.number}</span>
          <span lang={label(chapter).fallback ? 'de' : undefined}>{label(chapter).text}</span>
        </a>
        {chapter.children.length > 0 && (
          <ol class="toc-sub">
            {chapter.children.map((child) => (
              <li data-toc-item={child.anchor}>
                <a href={`#${child.anchor}`} class="toc-link" data-toc-link={child.anchor}>
                  <span class="toc-num">{child.number}</span>
                  <span lang={label(child).fallback ? 'de' : undefined}>{label(child).text}</span>
                </a>
              </li>
            ))}
          </ol>
        )}
      </li>
    ))
  }
</ol>

<style>
  .toc-list,
  .toc-sub {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-list > li + li {
    margin-top: 0.25rem;
  }
  .toc-sub {
    margin: 0.125rem 0 0.5rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--color-border);
  }
  .toc-link {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    min-height: 2.25rem;
    padding: 0.375rem 0.5rem;
    border-radius: 6px;
    font-size: var(--fs-small);
    line-height: 1.35;
    color: var(--color-muted);
    text-decoration: none;
    transition:
      color 150ms ease-out,
      background-color 150ms ease-out;
  }
  @media (pointer: coarse) {
    .toc-link {
      min-height: 44px;
      align-items: center;
    }
  }
  .toc-link:hover {
    color: var(--color-fg);
    background: var(--color-surface-2);
  }
  .toc-chapter {
    color: var(--color-fg);
    font-weight: 600;
  }
  .toc-link[aria-current='location'] {
    color: var(--color-fg);
    background: var(--color-surface-2);
    box-shadow: inset 2px 0 0 var(--color-teal);
  }
  .toc-num {
    flex: none;
    min-width: 2.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-teal);
  }
</style>
