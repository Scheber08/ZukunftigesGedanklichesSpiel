---
/**
 * Twitch-Player mit 2-Klick-Lösung (Plan §8.2, §9.2): Erst eine Vorschaufläche mit Hinweis
 * auf die Datenübertragung, das iframe fügt ein Skript erst nach dem Klick ein.
 * Ohne JavaScript bleibt nur der Link zu Twitch.
 */
import ExternalLink from '@lucide/astro/icons/external-link';
import Play from '@lucide/astro/icons/play';
import BrandIcon from '~/components/ui/BrandIcon.astro';
import Logo from '~/components/ui/Logo.astro';
import { url, useT, type Lang } from '~/i18n';
import { twitchChannelUrl } from '~/lib/content/stream';

interface Props {
  lang: Lang;
  /** Bereits geprüfter Kanalname (normalizeTwitchChannel) */
  channel: string;
}
const { lang, channel } = Astro.props;
const t = useT(lang);
const channelUrl = twitchChannelUrl(channel);
---

<div class="player-frame" data-stream-player data-channel={channel} data-title={t('content.stream.playerTitle', { channel })}>
  <div class="consent" data-stream-consent>
    <div class="consent-bg" aria-hidden="true">
      <div class="glow"></div>
      <span class="consent-logo"><Logo size="100%" /></span>
    </div>
    <div class="consent-body">
      <p class="consent-title">
        <BrandIcon name="twitch" size={22} />
        <span>{t('content.stream.consent.title')}</span>
      </p>
      <p class="consent-text">
        {t('content.stream.consent.text')}
        <a href={url(lang, 'privacy')} class="underline hover:text-teal">{t('content.stream.consent.privacy')}</a>.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <button type="button" class="btn btn-primary" data-stream-load hidden>
          <Play size={18} aria-hidden="true" />
          {t('content.stream.consent.load')}
        </button>
        <a href={channelUrl} class="btn btn-secondary" target="_blank" rel="noopener">
          {t('content.stream.consent.external')}
          <span class="sr-only">{t('a11y.externalLink')}</span>
          <ExternalLink size={16} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .player-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: #000;
  }
  .player-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .consent {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    overflow-y: auto;
  }
  .consent-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 60% at 30% 40%, rgb(11 96 67 / 0.45), transparent 70%),
      radial-gradient(60% 60% at 70% 60%, rgb(14 90 97 / 0.45), transparent 70%),
      var(--color-surface-1);
  }
  .consent-logo {
    position: absolute;
    right: -6%;
    bottom: -18%;
    width: 45%;
    max-width: 22rem;
    color: #fff;
    opacity: 0.08;
  }
  .consent-body {
    position: relative;
    display: grid;
    gap: 0.875rem;
    max-width: 36rem;
    text-align: center;
  }
  .consent-title {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 700;
    text-transform: uppercase;
  }
  .consent-text {
    font-size: var(--fs-small);
    color: var(--color-muted);
  }
  /* Schmale Bildschirme: Fläche wächst mit dem Text statt fester 16:9 */
  @media (max-width: 639px) {
    .player-frame:not(.is-loaded) {
      aspect-ratio: auto;
      min-height: 18rem;
    }
    .consent {
      position: relative;
      min-height: 18rem;
      padding: 1.5rem 1rem;
    }
  }
</style>

<script>
  import { twitchPlayerUrl } from '~/lib/content/stream';

  // 2-Klick: das iframe entsteht erst nach dem Klick auf „Stream laden“
  document.querySelectorAll<HTMLElement>('[data-stream-player]').forEach((frame) => {
    const button = frame.querySelector<HTMLButtonElement>('[data-stream-load]');
    const consent = frame.querySelector<HTMLElement>('[data-stream-consent]');
    const channel = frame.dataset.channel;
    if (!button || !consent || !channel) return;
    button.hidden = false;
    button.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = twitchPlayerUrl(channel, window.location.hostname);
      iframe.title = frame.dataset.title ?? 'Twitch';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.classList.add('is-loaded');
      consent.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>
