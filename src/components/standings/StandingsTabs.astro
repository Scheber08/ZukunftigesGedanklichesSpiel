---
/**
 * Umschalter Fahrer | Konstrukteure | Matrix als zugängliche Tabs (Plan §3.5, §4.4).
 *
 * Progressive Enhancement: Ohne JavaScript ist das eine Sprungnavigation zu den
 * Abschnitten, alle Panels sind sichtbar. Mit JavaScript wird daraus ein ARIA-Tablist
 * (Pfeiltasten, Pos1/Ende), inaktive Panels werden ausgeblendet und der gewählte Tab
 * landet im Anker der URL – so teilt der „Link kopieren“-Button genau diese Ansicht.
 *
 * Die Panels liegen in der View; sie brauchen nur die passende `id` und `data-tab-panel`.
 * Die Rolle „tablist“ bekommt ein inneres `div` – ein `nav` darf laut ARIA in HTML keine
 * andere Rolle als „navigation“ tragen.
 */
interface Props {
  /** Beschriftung der Navigation (aria-label) */
  label: string;
  tabs: Array<{ id: string; label: string }>;
  class?: string;
}
const { label, tabs, class: className } = Astro.props;
// Vor dem Skript (aber mit JS, data-js aus dem <head>): nur das erste Panel zeigen, damit beim
// Aktivieren nichts springt (CLS). Die Regel gilt nur bis das Skript übernimmt.
const firstId = (tabs[0]?.id ?? '').replace(/[^A-Za-z0-9_-]/g, '');
const preJs = firstId
  ? `html[data-js]:not([data-standings-tabs-ready]) [data-tab-panel]:not(#${firstId}){display:none}`
  : '';
---

{preJs && <style set:html={preJs}></style>}

<nav aria-label={label} class={className}>
  <div class="tabs standings-tabs" data-standings-tabs data-label={label}>
    {
      tabs.map((tab) => (
        <a href={`#${tab.id}`} id={`tab-${tab.id}`} class="tab" data-tab={tab.id}>
          {tab.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  /* .tabs scrollt (overflow-x: auto) und schneidet einen äußeren Fokusring ab – daher innen */
  .standings-tabs .tab:focus-visible {
    outline-offset: -2px;
  }
  /* Drei Tabs passen auch bei 320 px nebeneinander */
  .standings-tabs .tab {
    flex: 1 1 auto;
    justify-content: center;
    padding-inline: 0.75rem;
  }
  @media (min-width: 640px) {
    .standings-tabs .tab {
      flex: 0 0 auto;
      padding-inline: 1rem;
    }
  }
  @media (max-width: 380px) {
    .standings-tabs .tab {
      padding-inline: 0.4rem;
      font-size: 0.875rem;
      letter-spacing: 0.02em;
    }
  }
</style>

<script>
  /** Macht aus der Sprungnavigation eine Tablist nach dem WAI-ARIA-Muster (automatische Aktivierung). */
  function enhance(list: HTMLElement) {
    const tabs = [...list.querySelectorAll<HTMLAnchorElement>('a[data-tab]')];
    const panels = tabs.map((tab) => document.getElementById(tab.dataset.tab ?? ''));
    if (tabs.length < 2 || panels.some((p) => p == null)) return;

    list.setAttribute('role', 'tablist');
    if (list.dataset.label) list.setAttribute('aria-label', list.dataset.label);
    // Merker für das Layout der View (Abstände zwischen den Panels)
    list.closest('nav')?.setAttribute('data-tabs-enhanced', '');
    tabs.forEach((tab, i) => {
      const panel = panels[i]!;
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panel.id);
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tab.id);
      panel.tabIndex = 0;
    });

    const select = (index: number, opts: { focus?: boolean; updateUrl?: boolean } = {}) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i]!.hidden = !active;
      });
      if (opts.focus) tabs[index]!.focus();
      if (opts.updateUrl) history.replaceState(history.state, '', `#${tabs[index]!.dataset.tab}`);
    };

    const indexFromHash = () => {
      const id = decodeURIComponent(window.location.hash.slice(1));
      return tabs.findIndex((tab) => tab.dataset.tab === id);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        select(i, { updateUrl: true });
      });
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        let next: number | null = null;
        if (e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next == null) return;
        e.preventDefault();
        select(next, { focus: true, updateUrl: true });
      });
    });

    window.addEventListener('hashchange', () => {
      const i = indexFromHash();
      if (i >= 0) select(i);
    });

    const initial = indexFromHash();
    select(initial >= 0 ? initial : 0);
    document.documentElement.setAttribute('data-standings-tabs-ready', '');
  }

  document.querySelectorAll<HTMLElement>('[data-standings-tabs]').forEach(enhance);
</script>
