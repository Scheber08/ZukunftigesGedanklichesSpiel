---
/** Zwischenstand „Stand nach Runde X“ (Route 'standingsAfter'). */
import type { GetStaticPaths } from 'astro';
import StandingsAfterView from '~/components/standings/StandingsAfterView.astro';
import { loadLeague } from '~/lib/server/league';
import { standingsAfterPaths } from '~/lib/standings/page';

export const getStaticPaths = (async () => standingsAfterPaths(await loadLeague())) satisfies GetStaticPaths;

const { season, round } = Astro.params;
---

<StandingsAfterView lang="de" seasonSlug={season} round={Number(round)} />
