---
/**
 * Grid-Builder pro Runde (Plan §5.1): Vorbelegung aus der Saisonaufstellung, Abmeldungen,
 * Ersatzfahrer aus dem Reservepool, Live-Prüfungen, Entwurf und Veröffentlichung.
 */
export const prerender = false;

import AdminLayout from '~/layouts/AdminLayout.astro';
import RoundStatusBadge from '~/components/ui/RoundStatusBadge.astro';
import Forbidden from '~/components/admin/raceday/Forbidden.astro';
import GridBuilder from '~/components/admin/raceday/GridBuilder.svelte';
import { RacedayError } from '~/lib/admin/raceday/errors';
import { formatDateTime } from '~/lib/domain/time';
import { numberAt } from '~/lib/domain/numbers';
import { hasRole } from '~/lib/server/auth';
import { getServiceStore } from '~/lib/server/db';
import { isFrozen, loadLineupContext, type LineupContext } from '~/lib/server/results';
import { intParam, roundLabel, seasonLabel } from '~/lib/view';

const staff = Astro.locals.staff;
const allowed = hasRole(staff, 'admin');
const roundId = intParam(Astro.params.id);

let ctx: LineupContext | null = null;
if (allowed && roundId != null) {
  try {
    ctx = await loadLineupContext(getServiceStore(), roundId);
  } catch (err) {
    if (!(err instanceof RacedayError)) throw err;
  }
}
if (!allowed) Astro.response.status = 403;
else if (!ctx) Astro.response.status = 404;

const label = ctx ? roundLabel(ctx.basics.round, ctx.basics.track, 'de') : 'Runde';
const start = ctx ? new Date(ctx.basics.round.start_utc) : new Date();
const frozen = ctx ? isFrozen(ctx.basics.season) : false;
const cancelled = ctx?.basics.round.status === 'cancelled';
const readOnlyReason = frozen
  ? 'Die Saison ist abgeschlossen – die Aufstellung ist eingefroren und nur noch lesbar.'
  : cancelled
    ? 'Die Runde ist abgesagt.'
    : null;

const props = ctx && {
  roundId: ctx.basics.round.id,
  roundStatus: ctx.basics.round.status,
  readOnly: frozen || cancelled,
  readOnlyReason,
  hasResults: ctx.hasResults,
  teams: ctx.teams.map((t) => ({ id: t.id, name: t.name, color: t.color_hex })),
  drivers: ctx.drivers.map((d) => ({
    id: d.id,
    gamertag: d.gamertag,
    status: d.status,
    reserveOrder: d.reserve_order,
    number: numberAt(d.id, ctx!.numbers, start),
  })),
  seasonSeats: ctx.seasonSeats.map((s) => ({ team_id: s.team_id, seat_no: s.seat_no, driver_id: s.driver_id })),
  entries: ctx.entries.map((e) => ({ team_id: e.team_id, seat_no: e.seat_no, driver_id: e.driver_id })),
  absences: ctx.absences.map((a) => ({ driverId: a.driver_id, reportedInTime: a.reported_in_time })),
  bannedForRound: ctx.bannedForRound,
};
---

<AdminLayout
  title={`Grid · ${label}`}
  breadcrumbs={[
    { label: 'Runden', href: '/admin/runden' },
    { label, href: roundId != null ? `/admin/runden/${roundId}` : undefined },
    { label: 'Grid-Builder' },
  ]}
  wide
>
  {
    !allowed ? (
      <Forbidden roles="Admins" />
    ) : !ctx || !props ? (
      <p class="alert alert-danger" role="alert">
        Diese Runde gibt es nicht. <a href="/admin/runden" class="underline">Zur Rundenliste</a>
      </p>
    ) : (
      <>
        <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <RoundStatusBadge status={ctx.basics.round.status} lang="de" />
          <span class="text-muted">
            {seasonLabel(ctx.basics.season, 'de')} · Start {formatDateTime(ctx.basics.round.start_utc, 'de')} Uhr (Berlin)
          </span>
          {ctx.entries.length === 0 && <span class="badge badge-muted">Vorbelegt aus der Saisonaufstellung</span>}
          {ctx.bannedForRound.length > 0 && (
            <span class="badge badge-danger">{ctx.bannedForRound.length} Rennsperre(n) aus der Vorrunde</span>
          )}
          <a href={`/admin/runden/${ctx.basics.round.id}/ergebnisse`} class="underline hover:text-teal">
            Zur Ergebnis-Eingabe
          </a>
        </div>
        <noscript>
          <p class="alert alert-warning mb-4">Der Grid-Builder braucht JavaScript.</p>
        </noscript>
        <GridBuilder client:load {...props} />
      </>
    )
  }
</AdminLayout>
