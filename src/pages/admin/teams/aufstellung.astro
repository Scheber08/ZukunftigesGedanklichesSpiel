---
/**
 * Saisonaufstellung (Plan §5 „Teams und Cockpits“, §6.2 `seats`): Teams der Saison mit
 * Reihenfolge, zwei Cockpits pro Team, Transfers „gültig ab Runde X“ (der bisherige Eintrag
 * endet mit Runde X−1). Ein Fahrer kann nie in zwei Cockpits gleichzeitig sitzen.
 */
export const prerender = false;

import { actions } from 'astro:actions';
import Badge from '~/components/ui/Badge.astro';
import Flag from '~/components/ui/Flag.astro';
import ConfirmField from '~/components/admin/core/ConfirmField.astro';
import Notice from '~/components/admin/core/Notice.astro';
import SeasonSwitch from '~/components/admin/core/SeasonSwitch.astro';
import Section from '~/components/admin/core/Section.astro';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { DRIVER_STATUS_LABELS } from '~/lib/admin/league/labels';
import { actionOutcome, formValues } from '~/lib/admin/league/page';
import { FROZEN_MESSAGE, isSeasonFrozen } from '~/lib/admin/league/season';
import { findSeatConflicts, roundRangeLabel, seatAt } from '~/lib/admin/league/seats';
import { RESULT_VISIBLE_STATUSES, type DriverRow } from '~/lib/db/types';
import { currentNumber } from '~/lib/domain/numbers';
import { hasRole } from '~/lib/server/auth';
import { getServiceStore } from '~/lib/server/db';
import { roundLabel } from '~/lib/view';

if (!hasRole(Astro.locals.staff, 'admin')) return Astro.redirect('/admin?error=forbidden');
const A = actions.admin;
const outcome = await actionOutcome(Astro, [A.seasonTeamsSave, A.seatSave, A.seatRemove]);
if (outcome.redirect) return Astro.redirect(outcome.redirect, 303);

const store = getServiceStore();
const [seasons, teams, drivers, numbers, tracks] = await Promise.all([
  store.select('seasons'),
  store.select('teams'),
  store.select('drivers'),
  store.select('driver_numbers'),
  store.select('tracks'),
]);
const q = Astro.url.searchParams;
const wanted = Number(q.get('saison') ?? outcome.posted?.get('season_id') ?? NaN);
const season =
  seasons.find((s) => s.id === wanted) ?? seasons.find((s) => s.status === 'active') ?? [...seasons].sort((a, b) => b.number - a.number)[0];

const [seasonTeams, seats, rounds] = season
  ? await Promise.all([
      store.select('season_teams', { eq: { season_id: season.id } }),
      store.select('seats', { eq: { season_id: season.id } }),
      store.select('rounds', { eq: { season_id: season.id } }),
    ])
  : [[], [], []];
const frozen = isSeasonFrozen(season);
const sortedRounds = [...rounds].sort((a, b) => a.number - b.number);
const withResults = sortedRounds.filter((r) => RESULT_VISIBLE_STATUSES.includes(r.status));
const nextOpen = sortedRounds.find((r) => r.status !== 'cancelled' && !RESULT_VISIBLE_STATUSES.includes(r.status));
const defaultRound = nextOpen?.number ?? (sortedRounds.at(-1)?.number ?? 0) + 1;
const viewRound = Math.max(1, Number(q.get('runde')) || defaultRound);
const maxRound = Math.max(defaultRound, sortedRounds.at(-1)?.number ?? 1);

const now = new Date();
const driverById = new Map(drivers.map((d) => [d.id, d]));
const name = (id: number) => {
  const d = driverById.get(id);
  return d ? (d.anonymized ? `Ehemaliger Fahrer #${d.id}` : d.gamertag) : `#${id}`;
};
const num = (id: number) => currentNumber(id, numbers, now);
const order = new Map(seasonTeams.map((st) => [st.team_id, st.sort_order]));
const seasonTeamList = teams.filter((t) => order.has(t.id)).sort((a, b) => (order.get(a.id) ?? 0) - (order.get(b.id) ?? 0));
const selectableTeams = [...teams]
  .filter((t) => t.active || order.has(t.id))
  .sort((a, b) => (order.get(a.id) ?? 99) - (order.get(b.id) ?? 99) || a.name.localeCompare(b.name, 'de'));

const pickable = drivers.filter((d) => !d.anonymized && d.status !== 'banned');
const groups: Array<{ label: string; list: DriverRow[] }> = (['active', 'reserve', 'inactive'] as const).map((st) => ({
  label: DRIVER_STATUS_LABELS[st],
  list: pickable
    .filter((d) => d.status === st)
    .sort((a, b) => (st === 'reserve' ? (a.reserve_order ?? 999) - (b.reserve_order ?? 999) : 0) || a.gamertag.localeCompare(b.gamertag, 'de')),
}));

const occupied = seasonTeamList.reduce((n, t) => n + ([1, 2] as const).filter((no) => seatAt(seats, t.id, no, viewRound)).length, 0);
const conflicts = findSeatConflicts(seats);
const seatedNow = new Set(seats.filter((s) => s.from_round <= viewRound && (s.to_round == null || s.to_round >= viewRound)).map((s) => s.driver_id));
const reserves = drivers
  .filter((d) => d.status === 'reserve' && !d.anonymized && !seatedNow.has(d.id))
  .sort((a, b) => (a.reserve_order ?? 999) - (b.reserve_order ?? 999));
const warnings: string[] = [];
if (frozen) warnings.push(FROZEN_MESSAGE);
for (const c of conflicts.drivers) warnings.push(`${name(c.driver_id)} ist in zwei Cockpits gleichzeitig eingetragen (${roundRangeLabel(c.a)} und ${roundRangeLabel(c.b)}).`);
if (conflicts.slots.length) warnings.push(`${conflicts.slots.length} Cockpit(s) sind doppelt belegt – bitte Einträge korrigieren.`);
const seatForm = formValues(outcome, A.seatSave);
const postedSlot = seatForm.active ? `${seatForm.str('team_id')}:${seatForm.str('seat_no')}` : null;
---

<AdminLayout title="Saisonaufstellung" wide breadcrumbs={[{ label: 'Teams & Cockpits', href: '/admin/teams' }, { label: 'Aufstellung' }]}>
  <SeasonSwitch seasons={seasons} currentId={season?.id} base="/admin/teams/aufstellung" />
  <Notice outcome={outcome} warnings={warnings} />

  {
    !season ? (
      <p class="alert alert-warning">
        Es gibt noch keine Saison.{' '}
        <a class="underline" href="/admin/saisons">
          Saison anlegen
        </a>
      </p>
    ) : (
      <>
        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
          <p class="text-muted">
            <span class="text-2xl font-bold text-fg tabular">{occupied}</span> von {seasonTeamList.length * 2} Cockpits besetzt (Stand R{viewRound})
            {withResults.length > 0 && <span class="block text-sm">Runden mit Ergebnis: {withResults.map((r) => `R${r.number}`).join(', ')} – deren Ergebnisse bleiben bei Transfers unverändert.</span>}
          </p>
          <form method="GET" action="/admin/teams/aufstellung" class="flex items-end gap-2">
            <input type="hidden" name="saison" value={season.id} />
            <div class="field">
              <label class="label" for="view-round">
                Stand zu Runde
              </label>
              <select id="view-round" name="runde" class="select">
                {Array.from({ length: maxRound }, (_, i) => i + 1).map((n) => {
                  const r = sortedRounds.find((x) => x.number === n);
                  return (
                    <option value={n} selected={n === viewRound}>
                      {r ? roundLabel(r, tracks.find((t) => t.id === r.track_id), 'de') : `R${n}`}
                    </option>
                  );
                })}
              </select>
            </div>
            <button type="submit" class="btn btn-secondary">
              Anzeigen
            </button>
          </form>
        </div>

        <div class="grid gap-4 md:grid-cols-2 2xl:grid-cols-3">
          {seasonTeamList.map((team) => {
            const teamSeats = seats.filter((s) => s.team_id === team.id).sort((a, b) => a.seat_no - b.seat_no || a.from_round - b.from_round);
            return (
              <section id={`team-${team.id}`} class="card p-4" aria-labelledby={`team-${team.id}-title`} style={`--team-color:${team.color_hex}`}>
                <h2 id={`team-${team.id}-title`} class="mb-3 flex items-center gap-2 text-lg uppercase">
                  <span class="team-stripe" aria-hidden="true" />
                  {team.name}
                </h2>
                {([1, 2] as const).map((no) => {
                  const cur = seatAt(seats, team.id, no, viewRound);
                  const history = teamSeats.filter((s) => s.seat_no === no);
                  const slotKey = `${team.id}:${no}`;
                  const own = postedSlot === slotKey;
                  const fid = `seat-${team.id}-${no}`;
                  return (
                    <div class="mb-4 border-t border-border pt-3">
                      <p class="micro">Cockpit {no}</p>
                      <p class="mt-1 flex flex-wrap items-center gap-2">
                        {cur ? (
                          <>
                            <span class="tabular text-muted">#{num(cur.driver_id) ?? '–'}</span>
                            <a class="font-semibold uppercase underline" href={`/admin/fahrer/${cur.driver_id}`}>
                              {name(cur.driver_id)}
                            </a>
                            <Flag code={driverById.get(cur.driver_id)?.nationality_code} lang="de" />
                            <span class="text-sm text-muted">{roundRangeLabel(cur)}</span>
                          </>
                        ) : (
                          <Badge variant="warning">Frei</Badge>
                        )}
                      </p>
                      {history.length > 1 && (
                        <p class="mt-1 text-sm text-muted">
                          Verlauf: {history.map((h) => `${name(h.driver_id)} (${roundRangeLabel(h)})`).join(' → ')}
                        </p>
                      )}
                      {!frozen && (
                        <details class="mt-2" open={own}>
                          <summary class="inline-flex min-h-[44px] cursor-pointer items-center text-sm text-teal">
                            {cur ? 'Transfer / neu besetzen' : 'Cockpit besetzen'}
                          </summary>
                          <form method="POST" action={A.seatSave} class="mt-2 grid gap-3">
                            <input type="hidden" name="season_id" value={season.id} />
                            <input type="hidden" name="team_id" value={team.id} />
                            <input type="hidden" name="seat_no" value={no} />
                            <div class="grid gap-3 sm:grid-cols-[1fr_8rem]">
                              <div class="field">
                                <label class="label" for={`${fid}-driver`}>
                                  Fahrer
                                </label>
                                <select id={`${fid}-driver`} name="driver_id" class="select">
                                  <option value="">– Cockpit leer lassen –</option>
                                  {groups.map((g) => (
                                    <optgroup label={g.label}>
                                      {g.list.map((d) => (
                                        <option value={d.id} selected={own && seatForm.str('driver_id') === String(d.id)}>
                                          {d.gamertag}
                                          {num(d.id) != null ? ` #${num(d.id)}` : ''}
                                          {seatedNow.has(d.id) ? ' (hat Cockpit)' : ''}
                                        </option>
                                      ))}
                                    </optgroup>
                                  ))}
                                </select>
                              </div>
                              <div class="field">
                                <label class="label" for={`${fid}-from`}>
                                  Gültig ab Runde
                                </label>
                                <input
                                  id={`${fid}-from`}
                                  name="from_round"
                                  type="number"
                                  min="1"
                                  max="99"
                                  class="input"
                                  value={own ? seatForm.str('from_round') : String(defaultRound)}
                                  required
                                />
                              </div>
                            </div>
                            <label class="checkbox text-sm" for={`${fid}-release`}>
                              <input id={`${fid}-release`} type="checkbox" name="release_other" value="true" checked={own && seatForm.bool('release_other', false)} />
                              <span>Bisheriges Cockpit des Fahrers ab dieser Runde freigeben (Wechsel innerhalb des Grids)</span>
                            </label>
                            {own && outcome.error && (
                              <p class="field-error" role="alert">
                                {outcome.error.message}
                              </p>
                            )}
                            <div>
                              <button type="submit" class="btn btn-primary">
                                Übernehmen
                              </button>
                            </div>
                          </form>
                        </details>
                      )}
                    </div>
                  );
                })}
                {!frozen && teamSeats.length > 0 && (
                  <details class="border-t border-border pt-2">
                    <summary class="inline-flex min-h-[44px] cursor-pointer items-center text-sm text-muted">Einträge korrigieren</summary>
                    <ul class="mt-2 grid gap-3">
                      {teamSeats.map((s) => (
                        <li>
                          <form method="POST" action={A.seatRemove} class="grid gap-2">
                            <input type="hidden" name="id" value={s.id} />
                            <p class="text-sm">
                              Cockpit {s.seat_no}: <span class="font-semibold">{name(s.driver_id)}</span> ({roundRangeLabel(s)})
                            </p>
                            <ConfirmField id={`seat-remove-${s.id}`} label="Diesen Eintrag entfernen (Fehlerkorrektur)" />
                            <div>
                              <button type="submit" class="btn btn-danger">
                                Entfernen
                              </button>
                            </div>
                          </form>
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
              </section>
            );
          })}
        </div>

        {seasonTeamList.length === 0 && <p class="alert alert-warning mb-6">Die Saison hat noch keine Teams – wähle sie unten aus.</p>}

        <div class="mt-6 grid gap-6 lg:grid-cols-2">
          <Section title="Reservepool" id="reserve" description={`Reihenfolge der Warteliste (Stand R${viewRound}, ohne Fahrer mit Cockpit). Ändern im Fahrerprofil.`}>
            {reserves.length === 0 ? (
              <p class="text-muted">Keine Reservefahrer.</p>
            ) : (
              <ol class="grid gap-1">
                {reserves.map((d, i) => (
                  <li class="flex items-center gap-2">
                    <span class="w-6 text-right tabular text-muted">{i + 1}.</span>
                    <a class="underline" href={`/admin/fahrer/${d.id}`}>
                      {d.gamertag}
                    </a>
                    <span class="text-sm text-muted">#{num(d.id) ?? '–'}</span>
                  </li>
                ))}
              </ol>
            )}
          </Section>

          <Section title="Teams der Saison" id="teams" description="Häkchen = Team fährt in dieser Saison. Reihenfolge bestimmt die Anzeige (Aufstellung, Grid, Wertung).">
            <form method="POST" action={A.seasonTeamsSave} class="grid gap-3">
              <input type="hidden" name="season_id" value={season.id} />
              <fieldset disabled={frozen}>
                <legend class="sr-only">Teams und Reihenfolge</legend>
                <div class="table-wrap">
                  <table class="timing-table">
                    <caption class="sr-only">Teams der Saison {season.name}</caption>
                    <thead>
                      <tr>
                        <th scope="col">Dabei</th>
                        <th scope="col">Team</th>
                        <th scope="col">Position</th>
                      </tr>
                    </thead>
                    <tbody>
                      {selectableTeams.map((t, i) => (
                        <tr>
                          <td>
                            <input
                              type="checkbox"
                              id={`st-${t.id}`}
                              name={`team_${t.id}`}
                              value="true"
                              checked={order.has(t.id)}
                              class="h-5 w-5 accent-[var(--color-green)]"
                            />
                          </td>
                          <th scope="row">
                            <label for={`st-${t.id}`} class="inline-flex min-h-[44px] items-center gap-2" style={`--team-color:${t.color_hex}`}>
                              <span class="team-stripe" aria-hidden="true" />
                              {t.name}
                              {!t.active && <span class="text-sm text-muted">(inaktiv)</span>}
                            </label>
                          </th>
                          <td>
                            <label class="sr-only" for={`so-${t.id}`}>
                              Position {t.name}
                            </label>
                            <input
                              id={`so-${t.id}`}
                              name={`order_${t.id}`}
                              type="number"
                              min="1"
                              max="99"
                              class="input w-20"
                              value={order.has(t.id) ? (order.get(t.id) ?? 0) + 1 : i + 1}
                            />
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <div class="mt-3">
                  <button type="submit" class="btn btn-primary">
                    Teams speichern
                  </button>
                </div>
              </fieldset>
            </form>
          </Section>
        </div>
      </>
    )
  }
</AdminLayout>
