---
/**
 * Einzelne Entscheidung (auch ohne Vorfall): Entwurf bearbeiten, zustimmen, veröffentlichen,
 * verwerfen bzw. zurücknehmen (Plan §5.3, Vier-Augen-Prinzip, Befangenheit).
 */
export const prerender = false;

import { actions } from 'astro:actions';
import AdminLayout from '~/layouts/AdminLayout.astro';
import RoundStatusBadge from '~/components/ui/RoundStatusBadge.astro';
import DecisionCard from '~/components/admin/raceday/DecisionCard.astro';
import DecisionForm, { type DecisionFormValues } from '~/components/admin/raceday/DecisionForm.astro';
import Forbidden from '~/components/admin/raceday/Forbidden.astro';
import RaceActionMessage from '~/components/admin/raceday/RaceActionMessage.astro';
import { flashQuery, flashText } from '~/lib/admin/raceday/flash';
import { SESSION_LABEL } from '~/lib/admin/raceday/labels';
import { stewardContext } from '~/lib/admin/raceday/queries';
import { VERDICTS, type IncidentRow, type Verdict } from '~/lib/db/types';
import { isConflicted, RESULT_AFFECTING_VERDICTS } from '~/lib/domain/decisions';
import { hasRole } from '~/lib/server/auth';
import { getServiceStore } from '~/lib/server/db';
import { voterNames } from '~/lib/server/stewarding';
import { intParam, roundLabel } from '~/lib/view';

const staff = Astro.locals.staff;
const allowed = hasRole(staff, 'steward', 'admin');
const isSteward = hasRole(staff, 'steward');
const decisionId = intParam(Astro.params.id);
const here = `/admin/stewards/entscheidung/${decisionId ?? ''}`;

const r = {
  save: Astro.getActionResult(actions.admin.decisionSave),
  vote: Astro.getActionResult(actions.admin.decisionVote),
  publish: Astro.getActionResult(actions.admin.decisionPublish),
  discard: Astro.getActionResult(actions.admin.decisionDiscard),
  revoke: Astro.getActionResult(actions.admin.decisionRevoke),
};

const store = getServiceStore();
const [decision] = allowed && decisionId != null ? await store.select('decisions', { eq: { id: decisionId } }) : [];

if (allowed && decisionId != null) {
  if (r.discard?.data) {
    const back = decision?.incident_id != null ? `/admin/stewards/${decision.incident_id}` : '/admin/stewards';
    return Astro.redirect(back + flashQuery('discarded'), 303);
  }
  if (r.save?.data) return Astro.redirect(here + flashQuery('saved', { ref: r.save.data.ref }), 303);
  if (r.vote?.data) return Astro.redirect(here + flashQuery('voted'), 303);
  if (r.publish?.data) {
    const d = r.publish.data;
    return Astro.redirect(here + (d.published ? flashQuery('published', { ref: d.ref, effect: d.effect }) : flashQuery('pending')), 303);
  }
  if (r.revoke?.data) return Astro.redirect(here + flashQuery('revoked', { ref: r.revoke.data.ref, effect: r.revoke.data.effect }), 303);
}
const failed = Object.values(r).find((x) => x?.error);

const incident: IncidentRow | null = decision?.incident_id != null ? ((await store.select('incidents', { eq: { id: decision.incident_id } }))[0] ?? null) : null;
const ctx = decision ? await stewardContext(store, decision.round_id, [decision.driver_id, ...(incident?.involved_driver_ids ?? [])]) : null;
if (!allowed) Astro.response.status = 403;
else if (!decision || !ctx) Astro.response.status = 404;

const conflicted = decision && staff ? isConflicted(staff.driverId, incident, decision.driver_id) : false;
const canDecide = isSteward && !conflicted;
const driverLabel = (id: number) => {
  const d = ctx?.drivers.get(id);
  if (!d) return `Fahrer #${id}`;
  return d.anonymized ? `Ehemaliger Fahrer #${d.id}` : d.gamertag;
};
const voters = decision ? await voterNames(store, decision.decided_by, staff) : [];
const label = ctx ? roundLabel(ctx.round, ctx.track, 'de') : '';
const session = ctx?.sessions.find((s) => s.id === decision?.session_id);
const flash = flashText(Astro.url.searchParams);

let values: DecisionFormValues = decision
  ? {
      decisionId: decision.id,
      incidentId: decision.incident_id,
      driverId: decision.driver_id,
      sessionId: decision.session_id,
      verdict: decision.verdict,
      timeSeconds: decision.time_seconds,
      positions: decision.positions,
      penaltyPoints: decision.penalty_points,
      reasoningDe: decision.reasoning_de,
      reasoningEn: decision.reasoning_en,
      ruleRef: decision.rule_ref,
      clipUrl: decision.clip_url,
    }
  : {};
if (decision && r.save?.error && Astro.request.method === 'POST') {
  try {
    const fd = await Astro.request.formData();
    const num = (k: string) => (fd.get(k) ? Number(fd.get(k)) : null);
    const verdict = String(fd.get('verdict') ?? '');
    values = {
      ...values,
      driverId: num('driverId'),
      sessionId: num('sessionId'),
      verdict: (VERDICTS as readonly string[]).includes(verdict) ? (verdict as Verdict) : values.verdict,
      timeSeconds: num('timeSeconds'),
      positions: num('positions'),
      penaltyPoints: num('penaltyPoints'),
      reasoningDe: String(fd.get('reasoningDe') ?? ''),
      reasoningEn: String(fd.get('reasoningEn') ?? ''),
      ruleRef: String(fd.get('ruleRef') ?? ''),
      clipUrl: String(fd.get('clipUrl') ?? ''),
    };
  } catch {
    // Körper nicht mehr lesbar
  }
}
---

<AdminLayout
  title={decision ? `Entscheidung ${decision.public_ref}` : 'Entscheidung'}
  breadcrumbs={[
    { label: 'Stewards', href: '/admin/stewards' },
    ...(incident ? [{ label: `Vorfall #${incident.id}`, href: `/admin/stewards/${incident.id}` }] : []),
    { label: decision?.public_ref ?? 'Entscheidung' },
  ]}
>
  {
    !allowed ? (
      <Forbidden roles="Stewards und Admins" />
    ) : !decision || !ctx ? (
      <p class="alert alert-danger" role="alert">
        Diese Entscheidung gibt es nicht. <a href="/admin/stewards" class="underline">Zum Eingang</a>
      </p>
    ) : (
      <>
        {flash && !failed && (
          <p class="alert alert-success mb-6" role="status">
            {flash}
          </p>
        )}
        <RaceActionMessage result={failed} />

        <div class="mb-6 flex flex-wrap items-center gap-3 text-sm">
          <RoundStatusBadge status={ctx.round.status} lang="de" />
          <span class="text-muted">{label}</span>
          {incident ? (
            <a href={`/admin/stewards/${incident.id}`} class="underline hover:text-teal">
              Zum Vorfall #{incident.id}
            </a>
          ) : (
            <span class="badge badge-muted">ohne Vorfall</span>
          )}
          {conflicted && <span class="badge badge-danger">befangen</span>}
        </div>

        {conflicted && (
          <p class="alert alert-warning mb-6">Du bist betroffen oder am Vorfall beteiligt und kannst hier nicht entscheiden.</p>
        )}
        {!isSteward && <p class="alert mb-6">Als Admin kannst du die Entscheidung ansehen. Entscheiden können nur Stewards.</p>}

        <DecisionCard
          decision={decision}
          driverLabel={driverLabel(decision.driver_id)}
          sessionLabel={session ? SESSION_LABEL[session.type] : null}
          voters={voters}
          twoStewardRule={ctx.season.two_steward_rule}
          canDecide={canDecide}
          hasVoted={staff != null && decision.decided_by.includes(staff.userId)}
          actions={{
            vote: actions.admin.decisionVote,
            publish: actions.admin.decisionPublish,
            discard: actions.admin.decisionDiscard,
            revoke: actions.admin.decisionRevoke,
          }}
          resultAffecting={RESULT_AFFECTING_VERDICTS.includes(decision.verdict)}
          roundFinal={ctx.round.status === 'final' || ctx.round.status === 'corrected'}
        />

        {decision.status === 'draft' && canDecide && (
          <section aria-labelledby="dec-edit" class="mt-8">
            <h2 id="dec-edit" class="mb-3 text-xl uppercase">
              Entwurf bearbeiten
            </h2>
            <DecisionForm
              action={actions.admin.decisionSave}
              idPrefix="edit"
              roundId={ctx.round.id}
              values={values}
              sessions={ctx.sessions}
              driverOptions={ctx.driverOptions}
              catalog={ctx.catalog}
              penaltyPointsEnabled={ctx.season.penalty_points_enabled}
              submitLabel="Änderungen speichern"
            />
            <p class="field-hint mt-3">Inhaltliche Änderungen setzen bisherige Stimmen zurück – nur deine Stimme bleibt.</p>
          </section>
        )}
      </>
    )
  }
</AdminLayout>
