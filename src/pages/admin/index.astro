---
/**
 * Admin-Dashboard (Plan §5): nächstes Rennen und offene Aufgaben je nach Rolle –
 * neue Anmeldungen, offene Vorfälle, vorläufige Ergebnisse mit Protestfristen,
 * Entscheidungs-Entwürfe, fehlende Übersetzungen, neue Kontaktanfragen.
 *
 * Zugleich die 403-Seite des Admin-Kerns: Module ohne passende Rolle schreiben per
 * `Astro.rewrite('/admin?error=forbidden')` hierher um (URL bleibt, Status 403, keine Daten).
 */
export const prerender = false;

import Badge from '~/components/ui/Badge.astro';
import NoAccess from '~/components/admin/core/NoAccess.astro';
import Section from '~/components/admin/core/Section.astro';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { formatHoursLeft, missingTranslations, protestDeadlines } from '~/lib/admin/league/dashboard';
import { ROUND_STATUS_BADGE, ROUND_STATUS_LABELS, ROUND_FORMAT_SHORT, SEASON_STATUS_LABELS } from '~/lib/admin/league/labels';
import { formatDateLong, formatDateTime, formatTime, timeZoneName } from '~/lib/domain/time';
import { url } from '~/i18n';
import { hasRole } from '~/lib/server/auth';
import { getServiceStore } from '~/lib/server/db';
import { roundLabel } from '~/lib/view';

const staff = Astro.locals.staff!;
const forbidden = Astro.url.searchParams.get('error') === 'forbidden';
if (forbidden) Astro.response.status = 403;
// Bei 403 nichts laden – nur der Hinweis
const show = !forbidden;
const isAdmin = show && hasRole(staff, 'admin');
const isSteward = show && hasRole(staff, 'steward', 'admin');
const isEditor = show && hasRole(staff, 'redakteur');
const deniedPath = Astro.originPathname === '/admin' ? Astro.url.pathname : Astro.originPathname;

const store = getServiceStore();
const now = new Date();
const [seasons, rounds, tracks] = show
  ? await Promise.all([store.select('seasons'), store.select('rounds'), store.select('tracks')])
  : [[], [], []];
const trackOf = (id: number) => tracks.find((t) => t.id === id);
const seasonOf = (id: number) => seasons.find((s) => s.id === id);

// Nächstes Rennen (noch nicht gestartet bzw. vor < 3 h gestartet, ohne Ergebnis)
const cutoff = now.getTime() - 3 * 3_600_000;
const next = [...rounds]
  .filter((r) => (r.status === 'scheduled' || r.status === 'lineup_published') && new Date(r.start_utc).getTime() > cutoff)
  .sort((a, b) => a.start_utc.localeCompare(b.start_utc))[0];
const nextSeason = next ? seasonOf(next.season_id) : undefined;
const hoursToNext = next ? (new Date(next.start_utc).getTime() - now.getTime()) / 3_600_000 : null;

const active = seasons.find((s) => s.status === 'active');
const activeRounds = active ? rounds.filter((r) => r.season_id === active.id) : [];
const activeDone = activeRounds.filter((r) => r.status === 'final' || r.status === 'corrected').length;

// Aufgaben
const [newRegs, openIncidents, drafts, newContacts] = await Promise.all([
  isAdmin ? store.select('registrations', { eq: { status: 'new' } }) : Promise.resolve([]),
  isSteward ? store.select('incidents', { in: { status: ['new', 'in_review'] } }) : Promise.resolve([]),
  isSteward ? store.select('decisions', { eq: { status: 'draft' } }) : Promise.resolve([]),
  isAdmin ? store.select('contact_messages', { eq: { status: 'new' } }) : Promise.resolve([]),
]);
const provisional = isAdmin || isSteward ? protestDeadlines(rounds, now) : [];
const newIncidents = openIncidents.filter((i) => i.status === 'new').length;

const translations = isEditor
  ? missingTranslations({
      news: await store.select('news'),
      faq: await store.select('faq_items'),
      rulesVersions: await store.select('rules_versions'),
      rulesSections: await store.select('rules_sections'),
      positions: await store.select('open_positions'),
      partners: await store.select('partners'),
      staff: await store.select('staff_members'),
    })
  : [];
const newsDrafts = isEditor ? (await store.select('news', { eq: { status: 'draft' } })).length : 0;
const translationTotal = translations.reduce((s, t) => s + t.count, 0);

interface Task {
  label: string;
  count: number;
  href: string;
  detail: string;
  urgent?: boolean;
}
const tasks: Task[] = [];
if (isAdmin) {
  tasks.push({
    label: 'Neue Anmeldungen',
    count: newRegs.length,
    href: '/admin/anmeldungen?status=new',
    detail: newRegs.length ? `Älteste vom ${formatDateTime(newRegs.map((r) => r.created_at).sort()[0]!, 'de')}` : 'Keine neuen Anmeldungen.',
    urgent: newRegs.length > 0,
  });
}
if (isSteward) {
  tasks.push({
    label: 'Offene Vorfälle',
    count: openIncidents.length,
    href: '/admin/stewards',
    detail: openIncidents.length ? `${newIncidents} neu, ${openIncidents.length - newIncidents} in Prüfung` : 'Keine offenen Vorfälle.',
    urgent: newIncidents > 0,
  });
  tasks.push({
    label: 'Entscheidungs-Entwürfe',
    count: drafts.length,
    href: '/admin/stewards',
    detail: drafts.length ? 'Noch nicht veröffentlicht.' : 'Keine Entwürfe offen.',
  });
}
if (isAdmin) {
  tasks.push({
    label: 'Vorläufige Ergebnisse',
    count: provisional.length,
    href: '/admin/runden',
    detail: provisional.length
      ? `${provisional.filter((p) => p.state === 'expired').length} mit abgelaufener Protestfrist`
      : 'Keine vorläufigen Ergebnisse.',
    urgent: provisional.some((p) => p.state === 'expired'),
  });
  tasks.push({
    label: 'Neue Kontaktanfragen',
    count: newContacts.length,
    href: '/admin/kontakt',
    detail: newContacts.length ? 'Unbeantwortet.' : 'Alles beantwortet.',
    urgent: newContacts.length > 0,
  });
}
if (isEditor) {
  tasks.push({
    label: 'Fehlende Übersetzungen',
    count: translationTotal,
    href: '#uebersetzungen',
    detail: translationTotal ? `In ${translations.length} Bereich${translations.length === 1 ? '' : 'en'} fehlt Englisch.` : 'Alles zweisprachig.',
  });
  tasks.push({
    label: 'News-Entwürfe',
    count: newsDrafts,
    href: '/admin/news',
    detail: newsDrafts ? 'Noch nicht veröffentlicht.' : 'Keine Entwürfe.',
  });
}
---

{
  forbidden ? (
    <AdminLayout title="Keine Berechtigung">
      <NoAccess path={deniedPath} roles={staff.roles} />
    </AdminLayout>
  ) : (
<AdminLayout title="Dashboard">
  <p class="mb-6 text-muted">
    Hallo {staff.name}! Hier siehst du, was gerade ansteht.
    {staff.demo && ' Du bist im Demo-Modus angemeldet – Änderungen landen nur im Speicher.'}
  </p>

  <div class="mb-6 grid gap-6 lg:grid-cols-2">
    <Section title="Nächstes Rennen" id="naechstes-rennen">
      {
        next ? (
          <div>
            <p class="text-2xl font-bold uppercase" style="font-family: var(--font-display)">
              {roundLabel(next, trackOf(next.track_id), 'de')}
            </p>
            <p class="mt-1 text-muted">
              {nextSeason?.name} · {ROUND_FORMAT_SHORT[next.format]}
            </p>
            <p class="mt-3">
              {formatDateLong(next.start_utc, 'de')}, {formatTime(next.start_utc, 'de')} {timeZoneName(next.start_utc, 'de')}
              {hoursToNext != null && hoursToNext > 0 && <span class="text-muted"> · {formatHoursLeft(hoursToNext).replace('noch ', 'in ')}</span>}
            </p>
            <p class="mt-2">
              <Badge variant={ROUND_STATUS_BADGE[next.status]}>{ROUND_STATUS_LABELS[next.status]}</Badge>
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              {isAdmin && (
                <a class="btn btn-primary" href={`/admin/runden/${next.id}`}>
                  Grid & Ergebnis
                </a>
              )}
              {isAdmin && (
                <a class="btn btn-ghost" href={`/admin/kalender/${next.id}`}>
                  Im Kalender
                </a>
              )}
              {nextSeason && (
                <a class="btn btn-ghost" href={url('de', 'race', { season: nextSeason.slug, round: next.number })}>
                  Rennseite
                </a>
              )}
            </div>
          </div>
        ) : (
          <p class="text-muted">
            Kein Rennen geplant.
            {isAdmin && (
              <>
                {' '}
                <a class="underline" href="/admin/kalender">
                  Kalender anlegen
                </a>
              </>
            )}
          </p>
        )
      }
    </Section>

    <Section title="Saison" id="saison">
      {
        active ? (
          <div>
            <p class="text-2xl font-bold uppercase" style="font-family: var(--font-display)">
              {active.name}
            </p>
            <p class="mt-1 text-muted">
              {SEASON_STATUS_LABELS[active.status]} · {active.game_version}
            </p>
            <p class="mt-3">
              {activeDone} von {activeRounds.filter((r) => r.status !== 'cancelled').length} Runden final
            </p>
            <div class="mt-2 h-2 overflow-hidden rounded-full bg-surface-2" aria-hidden="true">
              <div
                class="h-full"
                style={`width:${activeRounds.length ? Math.round((activeDone / Math.max(1, activeRounds.filter((r) => r.status !== 'cancelled').length)) * 100) : 0}%;background:var(--g-accent)`}
              />
            </div>
            {isAdmin && (
              <div class="mt-4 flex flex-wrap gap-2">
                <a class="btn whitespace-normal btn-ghost" href={`/admin/saisons/${active.id}`}>
                  Saison verwalten
                </a>
                <a class="btn btn-ghost" href={`/admin/kalender?saison=${active.id}`}>
                  Kalender
                </a>
              </div>
            )}
          </div>
        ) : (
          <p class="text-muted">
            Keine Saison aktiv.
            {isAdmin && (
              <>
                {' '}
                <a class="underline" href="/admin/saisons">
                  Saisons verwalten
                </a>
              </>
            )}
          </p>
        )
      }
    </Section>
  </div>

  <h2 class="mb-4 text-xl uppercase">Offene Aufgaben</h2>
  <ul class="mb-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    {
      tasks.map((t) => (
        <li>
          <a href={t.href} class="card card-hover flex h-full min-h-[44px] flex-col gap-1 p-4 no-underline">
            <span class="flex items-baseline justify-between gap-3">
              <span class="font-semibold">{t.label}</span>
              <span class:list={['text-3xl font-bold tabular', t.count > 0 ? (t.urgent ? 'text-warning' : 'text-teal') : 'text-muted']}>
                {t.count}
              </span>
            </span>
            <span class="text-sm text-muted">
              {t.count === 0 ? '✓ ' : t.urgent ? '! ' : ''}
              {t.detail}
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    provisional.length > 0 && (
      <Section title="Protestfristen" id="protestfristen" description="Vorläufige Ergebnisse – nach Fristende und Urteilen final setzen.">
        <div class="table-wrap">
          <table class="timing-table">
            <caption class="sr-only">Vorläufige Ergebnisse mit Protestfrist</caption>
            <thead>
              <tr>
                <th scope="col">Runde</th>
                <th scope="col">Frist bis</th>
                <th scope="col">Stand</th>
                {isAdmin && <th scope="col"><span class="sr-only">Aktion</span></th>}
              </tr>
            </thead>
            <tbody>
              {provisional.map((p) => (
                <tr>
                  <th scope="row" class="font-semibold">
                    {seasonOf(p.round.season_id)?.name} · {roundLabel(p.round, trackOf(p.round.track_id), 'de')}
                  </th>
                  <td>{p.round.protest_deadline ? formatDateTime(p.round.protest_deadline, 'de') : '–'}</td>
                  <td>
                    {p.state === 'expired' ? (
                      <Badge variant="warning">Abgelaufen – {formatHoursLeft(p.hoursLeft!).replace(' abgelaufen', '')}</Badge>
                    ) : p.state === 'open' ? (
                      <Badge variant="teal">Läuft – {formatHoursLeft(p.hoursLeft!)}</Badge>
                    ) : (
                      <Badge variant="muted">Keine Frist</Badge>
                    )}
                  </td>
                  {isAdmin && (
                    <td>
                      <a class="underline" href={`/admin/runden/${p.round.id}`}>
                        Zur Runde
                      </a>
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Section>
    )
  }

  {
    isEditor && (
      <Section
        title="Fehlende Übersetzungen"
        id="uebersetzungen"
        description="Ohne englische Fassung zeigt die Website den deutschen Text mit Hinweis."
      >
        {translations.length === 0 ? (
          <p class="text-muted">✓ Alle Inhalte sind zweisprachig.</p>
        ) : (
          <ul class="grid gap-3">
            {translations.map((t) => (
              <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-border pb-3 last:border-0">
                <span>
                  <span class="font-semibold">{t.label}</span>
                  <span class="text-muted"> · {t.count} ohne Englisch</span>
                  <span class="block text-sm text-muted">
                    z. B. {t.examples.join(' · ')}
                    {t.count > t.examples.length && ' …'}
                  </span>
                </span>
                <a class="btn btn-ghost" href={t.href}>
                  Bearbeiten
                </a>
              </li>
            ))}
          </ul>
        )}
      </Section>
    )
  }
</AdminLayout>
  )
}
