{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/client",
      "url": [
        "http://localhost/index.html",
        "http://localhost/kalender.html",
        "http://localhost/wertung.html",
        "http://localhost/rennen/2/4.html",
        "http://localhost/en.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200, "aggregationMethod": "median-run" }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 51200 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 307200 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
