# =============================================================================
# Umgebungsvariablen – Vorlage. Kopieren nach `.env` (wird NICHT eingecheckt).
#
#   cp .env.example .env
#
# Ohne `.env` startet `npm run dev` automatisch im Demo-Modus mit Beispieldaten –
# für die meisten Arbeiten an der Website braucht man hier gar nichts einzutragen.
#
# Legende:  [öffentlich]  landet im ausgelieferten HTML/JS bzw. im Server-Bundle – unkritisch
#           [geheim]      nur serverseitig; in Produktion als Worker-Secret setzen
#                         (`npx wrangler secret put NAME`), NIE in Git, nie in GitHub-Variablen
# Das Schema aller Variablen steht in astro.config.mjs (env.schema).
# Geheime Werte für den lokalen Worker-Laufzeitkontext gehören in `.dev.vars`
# (Vorlage: .dev.vars.example).
# =============================================================================

# ------------------------------------------------------------------ Betriebsart

# [öffentlich] true = In-Memory-Beispieldaten statt Supabase (Demo, Vorschau, E2E-Tests).
# Lokal ohne SUPABASE_URL automatisch aktiv. Für einen Build ohne Datenbank MUSS es true sein.
DEMO_MODE=true

# [öffentlich] true = alle Seiten mit noindex (geschlossene Beta, Plan M7). Im Demo-Modus immer an.
SITE_NOINDEX=false

# ------------------------------------------------------------------ Website

# [öffentlich] Basis-URL ohne Schrägstrich am Ende (Canonical, hreflang, Sitemap, OG-Bilder).
# Solange die Domain nicht feststeht: https://liga.example
PUBLIC_SITE_URL=http://localhost:4321

# ------------------------------------------------------------------ Supabase (Datenbank, Login, Dateien)
# Woher: Supabase-Dashboard → Project Settings → API (bzw. „Data API“ / „API Keys“)

# [öffentlich] Projekt-URL, z. B. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# [öffentlich] anon/publishable Key – darf nur lesen, was die RLS-Policies erlauben
SUPABASE_ANON_KEY=

# [geheim] service_role/secret Key – umgeht RLS! Nur im Worker (Admin, Formulare, Cron)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ Discord
# Woher: Discord → Benutzereinstellungen → Erweitert → „Entwicklermodus“ an,
#        dann Rechtsklick auf den Liga-Server → „Server-ID kopieren“

# [öffentlich] ID des Liga-Servers (für die Rollenprüfung beim Staff-Login)
DISCORD_GUILD_ID=

# [geheim] Bot-Token der Discord-Application (Developer Portal → Bot → Reset Token).
# Der Bot braucht nur Lesezugriff auf Mitglieder (Server Members Intent), keine Admin-Rechte.
DISCORD_BOT_TOKEN=

# ------------------------------------------------------------------ Cloudflare Turnstile (Spam-Schutz der Formulare)
# Woher: Cloudflare-Dashboard → Turnstile → Widget hinzufügen (Modus „Managed“/„Invisible“)
# Zum Testen gibt es offizielle Dummy-Schlüssel, die immer bestehen:
#   Site-Key 1x00000000000000000000AA · Secret 1x0000000000000000000000000000000AA

# [öffentlich] Site-Key (wird im Formular ausgeliefert)
PUBLIC_TURNSTILE_SITE_KEY=

# [geheim] Secret-Key (Prüfung auf dem Server). Leer = im Demo-/Dev-Modus übersprungen.
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------ Datenschutz

# [geheim] Zufälliger Wert für die IP-Hashes (Rate-Limit) und die Zeitfalle der Formulare.
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nicht nachträglich ändern (sonst werden offene Formulare ungültig).
IP_HASH_SALT=

# ------------------------------------------------------------------ Rebuild nach „Veröffentlichen“ (Plan §7.2)

# [öffentlich] GitHub-Repository „besitzer/name“, dessen Workflow deploy.yml gestartet wird.
# In GitHub Actions automatisch gesetzt.
GITHUB_REPOSITORY=

# [geheim] Fine-grained Personal Access Token NUR für dieses Repository mit
# „Contents: Read and write“ (nötig für repository_dispatch). Ablaufdatum im Kalender notieren!
GITHUB_DISPATCH_TOKEN=

# ------------------------------------------------------------------ Twitch (vorbereitet, Plan §8.2)
# Woher: https://dev.twitch.tv/console/apps → Anwendung registrieren (Kategorie „Website Integration“)
# Die Live-Anzeige erscheint erst, wenn im Admin unter Einstellungen ein Kanal eingetragen ist.

# [geheim] Client-ID (wird nur serverseitig benutzt, deshalb hier als geheim geführt)
TWITCH_CLIENT_ID=

# [geheim] Client-Secret
TWITCH_CLIENT_SECRET=

# ------------------------------------------------------------------ Nur lokale Werkzeuge (nicht Teil der Website)

# Supabase CLI (supabase/config.toml): Discord-Login für die lokale Supabase-Instanz
# SUPABASE_AUTH_DISCORD_CLIENT_ID=
# SUPABASE_AUTH_DISCORD_SECRET=

# Playwright: gegen einen bereits laufenden Server testen statt einen eigenen zu starten
# E2E_BASE_URL=http://localhost:4321
